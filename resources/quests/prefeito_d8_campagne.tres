[resource]
script = ExtResource("1_quest")
id = "prefeito_d8_campagne"
display_name = "A virada"
description = "Avec le dossier, tu peux retourner l'opinion. Mais un moleque seul avec des papiers, le calçadão n'écoute pas — il faut que le bairro marche derrière quelqu'un. Va chercher le Padre, et la dette s'effacera au grand jour, par la vérité, pas par la soumission."
journal_text = "Convaincre le Padre de descendre en campagne, traverser le calçadão en cortège avec lui, puis renverser l'opinion avec la preuve."
giver_npc_id = "prefeito_tioze"
ink_knot = "spot_prefeito_tioze_d8_offer"
objectives = Array[Resource]([SubResource("obj_buscar_padre"), SubResource("obj_cortejo_calcadao"), SubResource("obj_flip_calcadao")])
money_reward = 3000
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["prefeito_d7_tioze"])
