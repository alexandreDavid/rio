[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_deliver_to_helena"]
script = ExtResource("2_obj")
id = "deliver_to_helena"
description = "Remettre le colis à Helena au MAC Niemeyer"
optional = false

[resource]
script = ExtResource("1_quest")
id = "bruno_carga"
display_name = "Encomenda da Barca"
description = "Bruno, vieux capitaine du ferry Rio↔Niterói, a un colis bloqué sur le dock depuis trois jours. Il ne quitte plus le ponton et ses jambes ne montent plus la rampe du MAC. Il te demande de remonter le colis à Helena, la curatrice."
journal_text = "Bruno (ferry, Niterói) → Helena (MAC, Niterói)"
giver_npc_id = "bruno"
ink_knot = "bruno_offer"
objectives = Array[Resource]([SubResource("obj_deliver_to_helena")])
money_reward = 180
reputation_rewards = {4: 3, 0: 2}
required_reputation = {}
required_act = 0
