[resource]
script = ExtResource("1_quest")
id = "trafico_a6_cagarras"
display_name = "Chargement par la mer"
description = "Un arrivage important entre par la mer, loin des yeux. Pas de bateau à moteur — trop de bruit, trop de regards. Tu pagaies jusqu'aux Cagarras en SUP, contre le courant, tu réceptionnes, tu ne comptes pas."
journal_text = "Rallier les Cagarras en SUP (contre le courant) et réceptionner le chargement."
giver_npc_id = "trafico_intim"
ink_knot = "spot_trafico_intim_a6_offer"
