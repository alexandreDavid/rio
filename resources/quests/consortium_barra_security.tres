[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_intimidate"]
script = ExtResource("2_obj")
id = "intimidate_magalhaes"
description = "Convaincre Sr. Magalhães qu'il a besoin de la « protection » du consortium"
optional = false

[sub_resource type="Resource" id="obj_close_deal"]
script = ExtResource("2_obj")
id = "close_deal"
description = "Repasser au condomínio Riserva Uno pour signer le contrat"
optional = false

[resource]
script = ExtResource("1_quest")
id = "consortium_barra_security"
display_name = "Le contrat de Riserva Uno"
description = "Dom Nilton te confie une mission discrète : convaincre le gérant du condomínio Riserva Uno à la Barra qu'il a besoin de payer une « protection » mensuelle au consortium. Première étape : lui faire comprendre la gravité de la chose. Deuxième : revenir signer le contrat. 800 R$ et 500 R$ d'effacement de dette à la clé."
journal_text = "Visite Sr. Magalhães au Riserva Uno (Barra), reviens signer après."
giver_npc_id = "consortium"
ink_knot = "consortium_barra_offer"
objectives = Array[Resource]([SubResource("obj_intimidate"), SubResource("obj_close_deal")])
money_reward = 800
reputation_rewards = {1: 3, 0: -2}
required_reputation = {}
required_act = 1
prerequisite_quest_ids = Array[String](["consortium_airport_pickup"])
