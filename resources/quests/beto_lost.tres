[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_find"]
script = ExtResource("2_obj")
id = "find_beto"
description = "Coincer Beto sur le calçadão (il fourgue des lunettes)"
optional = false

[sub_resource type="Resource" id="obj_return"]
script = ExtResource("2_obj")
id = "tell_vizinha"
description = "Dire à Seu Jorge que Beto remonte"
optional = false

[resource]
script = ExtResource("1_quest")
id = "beto_lost"
display_name = "Beto a séché"
description = "Seu Jorge, vieux du morro, en a marre : son petit-fils Beto, quinze ans, sèche encore pour fourguer des lunettes de contrefaçon sur le calçadão. Va le secouer et le faire remonter avant qu'il finisse pisteur pour le morro."
journal_text = "Retrouver Beto sur le calçadão et le renvoyer chez Seu Jorge."
giver_npc_id = "vizinho_jorge"
ink_knot = "spot_vizinho_jorge_offer"
objectives = Array[Resource]([SubResource("obj_find"), SubResource("obj_return")])
money_reward = 80
reputation_rewards = {0: 3}
required_reputation = {}
required_act = 0
