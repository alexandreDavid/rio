[resource]
script = ExtResource("1_quest")
id = "trafico_a5_intim"
display_name = "Quem fala demais"
description = "Un voisin du morro a vu le deal d'Ipanema et ne sait pas tenir sa langue. Tito veut qu'il comprenne. Pas de sang — juste la peur."
journal_text = "Remonter au morro, faire taire le voisin — et filer avant que la PM te serre."
