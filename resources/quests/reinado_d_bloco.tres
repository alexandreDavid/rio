[resource]
script = ExtResource("1_quest")
id = "reinado_d_bloco"
display_name = "O bloco do bairro"
description = "Le bairro a gagné — maintenant il doit défiler. Le Padre rêve d'un bloco du quartier, monté par ses gens : Dona Filó aux costumes, Careca à la voix. Un mutirão de plus, le plus joyeux : convaincs-les, et fais sortir le bloco."
journal_text = "Monter le Bloco do Bairro : convaincre Dona Filó et Careca, puis faire défiler."
giver_npc_id = "reinado_prefeito"
ink_knot = "spot_reinado_prefeito_r1_offer"
objectives = Array[Resource]([SubResource("obj_convencer_costureira"), SubResource("obj_convencer_puxador"), SubResource("obj_sair_bloco")])
money_reward = 800
reputation_rewards = {}
required_reputation = {}
required_act = 5
quest_type = 1
prerequisite_quest_ids = Array[String](["prefeito_d9_eleicao"])
