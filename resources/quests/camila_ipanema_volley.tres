[gd_resource type="Resource" script_class="Quest" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_match"]
script = ExtResource("2_obj")
id = "win_volley_match"
description = "Gagner un match de volley sur le sable d'Ipanema"
optional = false

[resource]
script = ExtResource("1_quest")
id = "camila_ipanema_volley"
display_name = "Areia de Ipanema"
description = "Camila monte une équipe sur le sable d'Ipanema. Trois sets, pas de pitié pour les touristes. Si tu enchaînes le service, t'es du sable."
journal_text = "Gagner un match de beach-volley contre l'équipe de Camila à Ipanema."
giver_npc_id = "camila"
ink_knot = "camila_offer"
objectives = Array[Resource]([SubResource("obj_match")])
money_reward = 200
reputation_rewards = {3: 3, 2: 2}
required_reputation = {}
required_act = 0
