[resource]
script = ExtResource("1_quest")
id = "consortium_c4_vip"
display_name = "Le visiteur"
description = "Un investisseur étranger atterrit à Santos Dumont — et un homme comme lui ne poireaute pas dans un hall. Tu le réceptionnes à l'heure, tu le promènes, tu souris à tout ce qu'il dit. La maison vend une image, et l'image commence à l'accueil."
journal_text = "Filer à l'aéroport Santos Dumont avant que le VIP ne s'impatiente (chrono)."
giver_npc_id = "consortium_zonasul"
ink_knot = "spot_consortium_zonasul_c4_offer"
objectives = Array[Resource]([SubResource("obj_drive_vip")])
money_reward = 1000
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["consortium_c3_partenariat"])
