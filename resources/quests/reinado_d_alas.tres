[resource]
script = ExtResource("1_quest")
id = "reinado_d_alas"
display_name = "As alas do povo"
description = "Le bloco du bairro est invité à ouvrir à la Sapucaí — inespéré. Mais au Sambódromo, le mestre de bateria veut placer les notables devant, « pour les caméras ». Le Padre t'envoie régler l'ordre du cortège. Souviens-toi de qui ce défilé est la victoire."
journal_text = "Régler l'ordre des alas avec le mestre de bateria — souviens-toi pour qui tu défiles."
giver_npc_id = "reinado_prefeito"
ink_knot = "spot_reinado_prefeito_r2_offer"
objectives = Array[Resource]([SubResource("obj_alinhar_alas")])
money_reward = 0
reputation_rewards = {}
required_reputation = {}
required_act = 5
quest_type = 1
prerequisite_quest_ids = Array[String](["reinado_d_bloco"])
