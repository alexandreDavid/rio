[gd_resource type="Resource" script_class="Quest" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_leak"]
script = ExtResource("2_obj")
id = "deliver_dossier"
description = "Remettre le dossier compromettant au journaliste (Fixer)"
optional = false

[resource]
script = ExtResource("1_quest")
id = "act4_press_expose"
display_name = "L'enveloppe à la presse"
description = "Un dossier traîne dans les couloirs : noms, comptes, signatures du consortium. Le Fixer connaît un journaliste prêt à le publier. 8 000 reais et un net coup de pied dans la fourmilière — le bairro respire mieux, mais les business souffrent."
journal_text = "Faire fuiter le dossier compromettant via la presse"
giver_npc_id = "fixer"
ink_knot = "fixer_offer_press_expose"
objectives = Array[Resource]([SubResource("obj_leak")])
money_reward = 8000
reputation_rewards = {0: 6, 4: -5}
required_reputation = {}
required_act = 4
quest_type = 1
prerequisite_quest_ids = Array[String]([])
