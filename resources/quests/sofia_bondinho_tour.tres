[sub_resource type="Resource" id="obj_summit"]
script = ExtResource("2_obj")
id = "guide_to_summit"
description = "Monter au sommet du Pão de Açúcar via le bondinho"
optional = false

[resource]
script = ExtResource("1_quest")
id = "sofia_bondinho_tour"
display_name = "Tour do Bondinho"
description = "Sofia, touriste japonaise un peu perdue, veut absolument monter au sommet du Pão de Açúcar mais n'ose pas le bondinho seule. Si tu fais le trajet avec elle, elle paie ton ticket et te file un pourboire."
journal_text = "Prendre le bondinho avec Sofia jusqu'au sommet du Pão de Açúcar."
giver_npc_id = "sofia"
ink_knot = "sofia_offer"
objectives = Array[Resource]([SubResource("obj_summit")])
money_reward = 180
reputation_rewards = {3: 5}
required_reputation = {}
required_act = 0
