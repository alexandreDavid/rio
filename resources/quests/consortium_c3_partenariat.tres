[resource]
script = ExtResource("1_quest")
id = "consortium_c3_partenariat"
display_name = "Le partenariat"
description = "Un restaurateur d'Ipanema refuse de signer. La maison ne casse rien — elle insiste, poliment, jusqu'à ce que la main tienne le stylo. C'est une autre forme de violence."
journal_text = "Aller en Zona Sul et obtenir la signature du restaurateur — écoute-le avant de choisir ton approche."
giver_npc_id = "consortium_barra"
ink_knot = "spot_consortium_barra_c3_offer"
