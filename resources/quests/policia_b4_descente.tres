[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_filer_dealer"]
script = ExtResource("2_obj")
id = "filer_dealer"
description = "Filer le dealer dans la foule d'Arpoador jusqu'à sa planque"
optional = false

[sub_resource type="Resource" id="obj_bust_dealer"]
script = ExtResource("2_obj")
id = "bust_dealer"
description = "Coffrer le dealer à sa planque (Arpoador, Zona Sul)"
optional = false

[resource]
script = ExtResource("1_quest")
id = "policia_b4_descente"
display_name = "Descente à Arpoador"
description = "Un dealer opère à Arpoador. Ramos veut une arrestation propre : tu le files d'abord jusqu'à sa planque — pas de flagrant délit, pas de dossier. Ça peut déraper — et ça dérape souvent."
journal_text = "Filer le dealer d'Arpoador jusqu'à sa planque, puis le coffrer."
giver_npc_id = "policia_escorte"
ink_knot = "spot_policia_escorte_b4_offer"
objectives = Array[Resource]([SubResource("obj_filer_dealer"), SubResource("obj_bust_dealer")])
money_reward = 600
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["policia_b3_escorte"])
