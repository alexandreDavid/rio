[resource]
script = ExtResource("1_quest")
id = "reinado_c_vitrine"
display_name = "Copacabana Riserva"
description = "La maison rebaptise le front de mer : parasols assortis, enseignes calibrées, « Copacabana Riserva ». Tous les barraqueiros ont signé la charte — sauf un. Magalhães ne veut pas d'une verrue sur la photo du Carnaval. Tu sais lire les gens, maintenant. Lis celui-là."
journal_text = "Faire signer la charte Riserva au dernier barraqueiro du front de mer — lis-le avant de choisir."
giver_npc_id = "reinado_consortium"
ink_knot = "spot_reinado_consortium_r1_offer"
