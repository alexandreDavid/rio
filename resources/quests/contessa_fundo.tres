[gd_resource type="Resource" script_class="Quest" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_filer"]
script = ExtResource("2_obj")
id = "filer_ferretti"
description = "Filer Ferretti, l'administrateur de la Contessa, depuis le Copa Palace"
optional = false

[sub_resource type="Resource" id="obj_colombo"]
script = ExtResource("2_obj")
id = "ecouter_colombo"
description = "Écouter son rendez-vous au Café Colombo du Forte"
optional = false

[sub_resource type="Resource" id="obj_decidir"]
script = ExtResource("2_obj")
id = "decidir_fundo"
description = "Rapporter à la Contessa ce que tu as entendu — et décider de ce qu'on en fait"
optional = false

[resource]
script = ExtResource("1_quest")
id = "contessa_fundo"
display_name = "O fundo do gala"
description = "L'argent du gala devait aller à l'orfanato du morro. Trois semaines plus tard, rien n'est arrivé, et Ferretti, l'administrateur milanais de la Contessa, parle de « délais bancaires ». Elle ne peut pas le suivre elle-même : tout le Palace connaît son visage. Le tien, personne ne le regarde."
journal_text = "Filer Ferretti depuis le Palace, l'écouter au Café Colombo du Forte, puis tout rapporter à la Contessa."
giver_npc_id = "contessa"
ink_knot = "contessa_fundo_offer"
objectives = Array[Resource]([SubResource("obj_filer"), SubResource("obj_colombo"), SubResource("obj_decidir")])
money_reward = 0
reputation_rewards = {}
required_reputation = {}
required_act = 3
prerequisite_quest_ids = Array[String](["act2_contessa_gala"])
