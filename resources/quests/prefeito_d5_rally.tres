[resource]
script = ExtResource("1_quest")
id = "prefeito_d5_rally"
display_name = "O comício"
description = "Le candidat civique du Padre tient meeting au Maracanã. Une estrade vide ne convainc personne : c'est un mutirão — va chercher le bairro. Dona Marta, Seu Válter, Rogério. Sans eux, pas de comício."
journal_text = "Mobiliser Dona Marta, Seu Válter et Rogério (Maracanã) pour le comício."
giver_npc_id = "prefeito_zonasul"
ink_knot = "spot_prefeito_zonasul_d5_offer"
objectives = Array[Resource]([SubResource("obj_convencer_marta"), SubResource("obj_convencer_valter"), SubResource("obj_convencer_rogerio")])
money_reward = 700
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["prefeito_d4_procession"])
