[sub_resource type="Resource" id="obj_seal_pacto"]
script = ExtResource("2_obj")
id = "seal_pacto"
description = "Sceller le Pacto da Barra — retourner voir Magalhães au Riserva Uno"
optional = false

[resource]
script = ExtResource("1_quest")
id = "pacto_barra"
display_name = "Pacto da Barra"
description = "Magalhães te recontacte. Les trois condomínios alignés, c'est un fief, plus une rente. Il propose de formaliser : rente mensuelle officielle, et un endossement politique tenu en réserve — contre un effacement massif de dette."
journal_text = "Magalhães, Riserva Uno (Barra). Pacto à sceller — endorsement politique en réserve."
giver_npc_id = "magalhaes"
ink_knot = "magalhaes_pacto_offer"
quest_type = 1
objectives = Array[Resource]([SubResource("obj_seal_pacto")])
money_reward = 5000
reputation_rewards = {4: 8}
required_reputation = {}
required_act = 2
prerequisite_quest_ids = Array[String](["consortium_peninsula"])
