[resource]
script = ExtResource("1_quest")
id = "trafico_a7_tioze"
display_name = "L'avertissement du Palace"
description = "Le contact dit qu'un vieux concierge du Copacabana Palace a quelque chose à te dire sur Tito. Et sur ton oncle. Mais le vieux ne parlera pas à un inconnu — fais parler le quartier d'abord."
journal_text = "Le concierge du Palace se tait devant les inconnus. Fais parler ceux qui ont connu Zé, recueille un souvenir de lui, puis retourne au Palace."
giver_npc_id = "trafico_cagarras"
ink_knot = "spot_trafico_cagarras_a7_offer"
objectives = Array[Resource]([SubResource("obj_ask_temoin"), SubResource("obj_porter_lembranca"), SubResource("obj_heed_warning")])
money_reward = 0
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["trafico_a6_cagarras"])
