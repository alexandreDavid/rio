[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_haul"]
script = ExtResource("2_obj")
id = "haul_catch"
description = "Réussir une session de pêche aux Cagarras"
optional = false

[resource]
script = ExtResource("1_quest")
id = "mateus_cagarras_pesca"
display_name = "Pesca das Cagarras"
description = "Mateus, pêcheur des Cagarras depuis vingt ans, organise un petit concours pour les nouveaux : qui ramène le poisson le plus gros emporte la prime. Le banc de pirajuba est sous l'îlot du milieu."
journal_text = "Aller aux Cagarras, réussir une session de pêche au FishingSpot."
giver_npc_id = "mateus"
ink_knot = "mateus_offer"
objectives = Array[Resource]([SubResource("obj_haul")])
money_reward = 220
reputation_rewards = {0: 3, 3: 1}
required_reputation = {}
required_act = 0
