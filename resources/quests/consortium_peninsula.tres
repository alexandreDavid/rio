[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_intimidate_mendonca"]
script = ExtResource("2_obj")
id = "intimidate_mendonca"
description = "Confronter Sr. Mendonça au Península Privé"
optional = false

[sub_resource type="Resource" id="obj_close_mendonca"]
script = ExtResource("2_obj")
id = "close_deal_mendonca"
description = "Revenir signer avec Mendonça — il aura prévenu son cousin"
optional = false

[resource]
script = ExtResource("1_quest")
id = "consortium_peninsula"
display_name = "Península, le dernier ticket"
description = "Mendonça préside le Península Privé. Helipad sur le toit, bodyguards à l'entrée, cousin commissaire au 19e DP. Le plus gros tarif, mais à partir d'ici la police saura. 1500 reais et 900 d'effacement de dette. Rep police en chute libre."
journal_text = "Sr. Mendonça, Península (Barra). Cousin commissaire = danger."
giver_npc_id = "consortium"
ink_knot = "consortium_peninsula_offer"
objectives = Array[Resource]([SubResource("obj_intimidate_mendonca"), SubResource("obj_close_mendonca")])
money_reward = 1500
reputation_rewards = {1: 5, 0: -4, 3: -5}
required_reputation = {}
required_act = 1
prerequisite_quest_ids = Array[String](["consortium_le_parc"])
