[resource]
script = ExtResource("1_quest")
id = "policia_b8_seguranca"
display_name = "Sécuriser la foule"
description = "Un rassemblement gêne le consortium. Ramos appelle ça « sécuriser la foule ». C'est le gros job — celui qui éponge presque toute ta dette. Mais avant les boucliers, il faut l'œil : savoir qui opère là-dedans."
journal_text = "Prendre le briefing au poste PM du Maracanã, repérer l'éclaireur des batedores dans la foule, puis sécuriser le stade."
giver_npc_id = "policia_saisie"
ink_knot = "spot_policia_saisie_b8_offer"
objectives = Array[Resource]([SubResource("obj_briefing_pm"), SubResource("obj_reperer_batedores"), SubResource("obj_secure_crowd")])
money_reward = 3000
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["policia_b7_saisie"])
