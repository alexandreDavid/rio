[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_varrer_sapucai"]
script = ExtResource("2_obj")
id = "varrer_sapucai"
description = "Balayer la foule de la Sapucaí — repérer le second batedor (planque)"
optional = false

[sub_resource type="Resource" id="obj_report_camarote"]
script = ExtResource("2_obj")
id = "report_camarote"
description = "Rendre compte au poste de commandement du camarote"
optional = false

[resource]
script = ExtResource("1_quest")
id = "reinado_b_camarote"
display_name = "Sapucaí limpa"
description = "Le batedor du calçadão a parlé : son binôme opère à la Sapucaí, dans la foule des répétitions. Ramos t'envoie seul — « c'est ton règne, prouve-le ». La pire planque depuis le Maracanã, et cette fois personne en renfort."
journal_text = "Repérer le second batedor dans la foule de la Sapucaí, puis rendre compte au camarote."
giver_npc_id = "reinado_policia"
ink_knot = "spot_reinado_policia_r2_offer"
objectives = Array[Resource]([SubResource("obj_varrer_sapucai"), SubResource("obj_report_camarote")])
money_reward = 0
reputation_rewards = {}
required_reputation = {}
required_act = 5
quest_type = 1
prerequisite_quest_ids = Array[String](["reinado_b_ronda"])
