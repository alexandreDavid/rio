[resource]
script = ExtResource("1_quest")
id = "policia_b6_tioze"
display_name = "Tu nettoies pour qui ?"
description = "Un vieux concierge du Palace a une question dérangeante sur Ramos. Et sur ton oncle. Mais le vieux ne parlera pas à un inconnu — fais parler le quartier d'abord."
journal_text = "Le concierge du Palace se tait devant les inconnus. Fais parler ceux qui ont connu Zé, recueille un souvenir de lui, puis retourne au Palace."
giver_npc_id = "policia_reperage"
ink_knot = "spot_policia_reperage_b6_offer"
objectives = Array[Resource]([SubResource("obj_ask_temoin"), SubResource("obj_porter_lembranca"), SubResource("obj_reperer_sombra"), SubResource("obj_hear_concierge")])
money_reward = 0
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["policia_b5_reperage"])
