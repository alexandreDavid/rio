[gd_resource type="Resource" script_class="Quest" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_haul_baia"]
script = ExtResource("2_obj")
id = "haul_baia"
description = "Réussir une session de pêche au ponton de Niterói"
optional = false

[resource]
script = ExtResource("1_quest")
id = "bruno_pesca_baia"
display_name = "Pesca da Baía"
description = "Bruno te connaît assez maintenant pour te confier sa canne. « La baie de Guanabara, c'est mille robalos par mètre carré, sobrinho. Pêche-en un — un seul — et tu verras pourquoi je n'ai jamais quitté ce ponton. » Une session, un poisson, et il te paie de la cachaça."
journal_text = "Sortir la canne au ponton de Niterói (FishingSpot)."
giver_npc_id = "bruno"
ink_knot = "bruno_pesca_offer"
objectives = Array[Resource]([SubResource("obj_haul_baia")])
money_reward = 220
reputation_rewards = {2: 3, 3: 1}
required_reputation = {}
required_act = 0
prerequisite_quest_ids = Array[String](["bruno_carga"])
