[resource]
script = ExtResource("1_quest")
id = "reinado_a_pedagio"
display_name = "O pedágio do rei"
description = "Le morro est à toi — mais un règne, ça s'entretient. Tito veut que Copacabana sache qui protège le calçadão maintenant. Tu passes chez les camelôs, tu encaisses le pedágio. Et gare à la PM qui n'a pas encore compris qui commande."
journal_text = "Encaisser le pedágio des camelôs du calçadão — et semer la PM pas encore « alignée »."
giver_npc_id = "reinado_trafico"
ink_knot = "spot_reinado_trafico_r1_offer"
objectives = Array[Resource]([SubResource("obj_collect_pedagio"), SubResource("obj_fugir_blitz")])
money_reward = 800
reputation_rewards = {}
required_reputation = {}
required_act = 5
quest_type = 1
prerequisite_quest_ids = Array[String](["trafico_a9_corrida"])
