[resource]
script = ExtResource("1_quest")
id = "trafico_a8_baia"
display_name = "La traversée"
description = "Le gros coup. Une cargaison passe la baie jusqu'à Niterói — mais la baía a ses maîtres. Sans le mot de la Mafia da Baía, aucune barque n'accoste. Ça paie presque toute la dette. Pas le droit à l'erreur."
journal_text = "Remonter la filière à Niterói : le feu vert de la Mafia aux barcas, la crique de débarque à Icaraí — puis convoyer la cargaison, et disparaître si la PM tombe dessus."
giver_npc_id = "trafico_tioze"
ink_knot = "spot_trafico_tioze_a8_offer"
objectives = Array[Resource]([SubResource("obj_feu_vert_mafia"), SubResource("obj_reperer_crique"), SubResource("obj_cross_baia"), SubResource("obj_semer_flagrante")])
money_reward = 3000
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["trafico_a7_tioze"])
