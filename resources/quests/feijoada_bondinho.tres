[resource]
script = ExtResource("1_quest")
id = "feijoada_bondinho"
display_name = "Feijoada en altitude"
description = "L'opérateur du bondinho a une commande pour un dîner d'affaires au mirante. Trois paniers de feijoada, livrés chauds. Le bondinho est offert pour la course."
journal_text = "Prendre le bondinho de Botafogo et livrer la feijoada au chef du sommet."
giver_npc_id = "bondinho_operador"
ink_knot = "spot_bondinho_operador_offer"
objectives = Array[Resource]([SubResource("obj_deliver")])
money_reward = 800
reputation_rewards = {3: 2}
required_reputation = {3: 8}
required_act = 0
