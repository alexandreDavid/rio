[resource]
script = ExtResource("1_quest")
id = "reinado_b_ronda"
display_name = "A ronda do Capitão"
description = "Le badge est à toi, et les blocos de Copa débordent de monde — le terrain rêvé pour les batedores de la Baía. Ramos veut un Carnaval sans une seule manchette sanglante. Ta ronde, tes yeux. Comme au Maracanã, mais chez toi."
journal_text = "Repérer le batedor infiltré dans le bloco du calçadão, puis le faire cueillir sans esclandre."
giver_npc_id = "reinado_policia"
ink_knot = "spot_reinado_policia_r1_offer"
objectives = Array[Resource]([SubResource("obj_vigiar_bloco"), SubResource("obj_prender_batedor")])
money_reward = 800
reputation_rewards = {}
required_reputation = {}
required_act = 5
quest_type = 1
prerequisite_quest_ids = Array[String](["policia_b9_madrugada"])
