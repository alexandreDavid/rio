[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_answer_quiz"]
script = ExtResource("2_obj")
id = "answer_quiz"
description = "Répondre aux trois questions de Ronaldo sur le Maracanã"
