[resource]
script = ExtResource("1_quest")
id = "quiz_maracana"
display_name = "Quiz do Maracanã"
description = "Ronaldo, entre deux torcidas, organise un quiz informel pour les habitués : trois questions sur l'histoire du Maracanã. Bonnes réponses = respect du quartier, mauvaise réponse = chambrage."
journal_text = "Trois questions de Ronaldo au Maracanã."
giver_npc_id = "musicien"
ink_knot = "ronaldo_quiz_offer"
objectives = Array[Resource]([SubResource("obj_answer_quiz")])
money_reward = 150
reputation_rewards = {}
required_reputation = {}
required_act = 0
prerequisite_quest_ids = Array[String](["ronaldo_aterro_basket"])
