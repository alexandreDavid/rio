[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_find"]
script = ExtResource("2_obj")
id = "find_jersey"
description = "Récupérer le maillot 71 chez le vendeur d'Aterro do Flamengo"
optional = false

[sub_resource type="Resource" id="obj_return"]
script = ExtResource("2_obj")
id = "return_jersey"
description = "Ramener le maillot au vieux supporter du Maracanã"
optional = false

[resource]
script = ExtResource("1_quest")
id = "maracana_jersey"
display_name = "Le maillot 71"
description = "Un vieux supporter du Maracanã a passé six mois à pister un maillot dédicacé de la finale 71. Le revendeur d'Aterro do Flamengo le détient enfin. Va le chercher, ramène-le-lui — sa femme veut l'encadrer pour ses 70 ans."
journal_text = "Aller à Aterro do Flamengo récupérer le maillot, puis revenir au Maracanã."
giver_npc_id = "maracana_torcedor"
ink_knot = "spot_maracana_torcedor_offer"
objectives = Array[Resource]([SubResource("obj_find"), SubResource("obj_return")])
money_reward = 1800
reputation_rewards = {4: 4, 0: 2}
required_reputation = {}
required_act = 0
