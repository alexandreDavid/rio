[resource]
script = ExtResource("1_quest")
id = "baia_pacto"
display_name = "Pacto da Baía"
description = "Don Vincenzo te tend la main : partenariat officiel sur les passages de la baie. Ferry gratuit à vie, 3000 R$ d'effacement de dette, 2000 R$ cash, et un pied dans l'organisation. La presse est silencieuse, la route est libre."
journal_text = "Vincenzo au Café da Praça (Niterói). Décision : sceller ou refuser."
giver_npc_id = "don_vincenzo"
ink_knot = "vincenzo_pacto_offer"
objectives = Array[Resource]([SubResource("obj_seal_pacto_baia")])
money_reward = 2000
reputation_rewards = {2: 6, 1: -3, 4: 4}
required_reputation = {}
required_act = 1
prerequisite_quest_ids = Array[String](["baia_silence_press"])
