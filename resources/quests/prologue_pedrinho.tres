[gd_resource type="Resource" script_class="Quest" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_ask_mae"]
script = ExtResource("2_obj")
id = "ask_mae"
description = "Parler à la mère de Pedrinho (favela)"
optional = false

[sub_resource type="Resource" id="obj_ask_vovo"]
script = ExtResource("2_obj")
id = "ask_vovo"
description = "Demander à la vovó ce qu'elle a vu"
optional = false

[sub_resource type="Resource" id="obj_ask_garoto"]
script = ExtResource("2_obj")
id = "ask_garoto"
description = "Faire parler le gamin qui jouait avec lui (Juca)"
optional = false

[sub_resource type="Resource" id="obj_find_pedrinho"]
script = ExtResource("2_obj")
id = "find_pedrinho"
description = "Retrouver Pedrinho dans la vieille citerne"
optional = false

[sub_resource type="Resource" id="obj_bring_home"]
script = ExtResource("2_obj")
id = "bring_home"
description = "Ramener Pedrinho à sa mère"
optional = false

[resource]
script = ExtResource("1_quest")
id = "prologue_pedrinho"
display_name = "Cadê o Pedrinho?"
description = "Un enfant du morro, Pedrinho, a disparu cette nuit. Sa mère est effondrée, la police s'en fiche. Tu ne quitteras pas le morro sans l'avoir retrouvé."
journal_text = "Interroger la mère, la vovó, puis Juca — retrouver Pedrinho dans la citerne et le ramener à sa mère."
giver_npc_id = "vizinha"
ink_knot = "mae_prologue_offer"
objectives = Array[Resource]([SubResource("obj_ask_mae"), SubResource("obj_ask_vovo"), SubResource("obj_ask_garoto"), SubResource("obj_find_pedrinho"), SubResource("obj_bring_home")])
money_reward = 0
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String]([])
