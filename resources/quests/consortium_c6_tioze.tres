[gd_resource type="Resource" script_class="Quest" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/quests/Quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quests/QuestObjective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_ask_temoin"]
script = ExtResource("2_obj")
id = "ask_temoin"
description = "Faire parler ceux qui ont connu le concierge"
optional = false

[sub_resource type="Resource" id="obj_porter_lembranca"]
script = ExtResource("2_obj")
id = "porter_lembranca"
description = "Recueillir un souvenir de l'oncle Zé"
optional = false

[sub_resource type="Resource" id="obj_hear_concierge"]
script = ExtResource("2_obj")
id = "hear_concierge"
description = "Écouter le concierge du Copacabana Palace"
optional = false

[resource]
script = ExtResource("1_quest")
id = "consortium_c6_tioze"
display_name = "Ce que le vieux a vu"
description = "Un vieux concierge du Palace dit qu'il a vu, jadis, ce qu'est vraiment le Consórcio. Il veut te le dire avant que tu signes. Mais le vieux ne parlera pas à un inconnu — fais parler la maison d'abord."
journal_text = "Le concierge du Palace se tait devant les inconnus. Fais parler ceux qui ont connu Zé, recueille un souvenir de lui, puis retourne au Palace."
giver_npc_id = "consortium_niteroi"
ink_knot = "spot_consortium_niteroi_c6_offer"
objectives = Array[Resource]([SubResource("obj_ask_temoin"), SubResource("obj_porter_lembranca"), SubResource("obj_hear_concierge")])
money_reward = 0
reputation_rewards = {}
required_reputation = {}
required_act = 0
quest_type = 1
prerequisite_quest_ids = Array[String](["consortium_c5_mac"])
