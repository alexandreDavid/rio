[node name="MotherSpot" parent="." instance=ExtResource("5_reactive")]
position = Vector2(120, -50)
npc_id = "mae"
prompt = "Parler à Mãe"
character_seed = 70411
variants = [{
"id": "jantar",
"phase": 2,
"act_max": 3,
"flag_not_today": "jantar_day",
"set_flag_day_after": "jantar_day",
"speaker": "Mãe",
"text": "*elle pose la marmite au milieu de la table — trois assiettes, la troisième reste vide, comme chaque soir* Senta, meu filho. Mange pendant que c'est chaud. *elle te regarde manger plus qu'elle ne mange* Raconte-moi ta journée. Pas les chiffres — le reste. Qui t'a souri, qui t'a regardé de travers. *un silence, les yeux sur l'assiette vide* Demain tu repars tôt, je sais. Mais ce soir tu es là, et ça, personne ne nous le prend.",
"choices": ["Obrigado, mãe"]
}, {
"id": "ze_hibiscus",
"flag": "ze_rescued",
"not_flag": "mae_hibiscus_seen",
"set_flag_after": "mae_hibiscus_seen",
"speaker": "Mãe",
"text": "*elle arrose les hibiscus du balcon, dos à toi* Quelqu'un a laissé des fleurs sur la tombe, dimanche. Des hibiscus. *un long silence* La seule personne au monde qui savait que je préfère les hibiscus aux roses, c'était mon frère. *elle ne se retourne toujours pas* Les morts n'apportent pas de fleurs, meu filho. *sa voix ne tremble pas* Quand tu seras prêt à me dire ce que tu sais, je serai prête à l'entendre. Je le suis depuis huit ans.",
"choices": ["…Bientôt, mãe. Promis."]
}, {
"id": "ze_secret",
"flag": "tio_ze_revealed",
"not_flag": "mae_secret_seen",
"set_flag_after": "mae_secret_seen",
"speaker": "Mãe",
"text": "*elle raccommode une chemise qui n'est pas à ta taille* Tu as le regard de Zé, ces derniers temps. Celui de l'année avant la noyade — quand il portait quelque chose de trop lourd et qu'il croyait qu'on ne voyait rien. *elle coupe le fil avec les dents, comme sa mère avant elle* Les femmes de cette famille voient tout, meu filho. On attend juste que vous soyez prêts.",
"choices": ["…Ce n'est rien, mãe"]
}, {
"id": "pos_carnaval_ze",
"quest_completed": "act4_carnaval_desfile",
"flag": "ze_rescued",
"speaker": "Mãe",
"text": "*elle sort une assiette de plus de l'étagère, la repose, la ressort* Samedi, on sera un de plus à table. *elle rit toute seule, puis s'arrête net* Vingt ans que je mets le couvert de mon frère pour rien, meu filho. Samedi, il mange dedans. *elle te pousse vers la porte* Va. Et rapporte du pain de chez le padeiro — Zé le prend toujours trop cuit.",
"choices": ["Trop cuit, entendu"]
}, {
"id": "pos_carnaval",
"quest_completed": "act4_carnaval_desfile",
"speaker": "Mãe",
"text": "*elle range dans une malle les fantasias de quand tu étais petit, et garde une plume à part* Le Carnaval est passé, meu filho. Tu es rentré entier — c'est tout ce que je demandais. *elle referme la malle* Samedi, feijoada. Je mets toujours le couvert de Zé. Je ne sais pas faire autrement.",
"choices": ["Sábado, mãe"]
}, {
"id": "carnaval",
"act": 5,
"speaker": "Mãe",
"text": "*essuie ses mains sur son tablier* Mon roi du Sambódromo. Tu rentres à quatre heures du matin maintenant — mais tu rentres entier. C'est tout ce que je demandais à ton oncle. Va, va. La moqueca chauffe.",
"choices": ["Obrigado, mãe"]
}, {
"id": "sick",
"flag": "mae_sick_triggered",
"not_flag": "mae_sick_seen",
"set_flag_after": "mae_sick_seen",
"speaker": "Mãe",
"text": "*tousse profondément, s'assied sur la chaise sans pouvoir terminer la moqueca* Ne t'inquiète pas, filho. *reprend son souffle* Vovó dit que je marche trop vite vers la chapelle. *te tend une enveloppe pliée trois fois* Pour la pharmacie de Tito — il a une remise pour la famille maintenant. Si tu peux passer, je dormirai mieux.",
"choices": ["Vai dar tudo certo, mãe"]
}, {
"id": "revisit",
"flag": "mae_consortium_revisit_triggered",
"not_flag": "mae_revisit_seen",
"set_flag_after": "mae_revisit_seen",
"speaker": "Mãe",
"text": "*ne se retourne pas, fixe la marmite* Ils sont revenus aujourd'hui. Trois hommes cette fois. *touille très lentement* Ils ont demandé du sucre. Du sucre, filho. Pour me faire savoir qu'ils savent où on vit, où je range mes provisions, comment fonctionne ma cuisine. *te regarde enfin* Continue de payer. Mais pas trop vite. Si tu paies trop vite ils penseront que tu mens sur tes revenus.",
"choices": ["Compris, mãe"]
}, {
"id": "letter",
"flag": "mae_letter_triggered",
"not_flag": "mae_letter_seen",
"set_flag_after": "mae_letter_seen",
"speaker": "Mãe",
"text": "*tient une enveloppe froissée, les mains tremblantes* Meu filho... un homme du consortium est passé pendant que tu vendais. Costume blanc, sourire trop large. *te tend la lettre, une croix noire au dos* Ils savent que t'es le neveu de Zé. Ils savent où on dort. *éclate en larmes silencieuses, sans bouger* Promets-moi que tu rentres entier ce soir. Promets-moi.",
"choices": ["Promets, mãe"]
}, {
"id": "after_payment",
"flag": "first_payment_done",
"set_flag_after": "home_visit_done",
"speaker": "Mãe",
"text": "*pose la louche, te regarde enfin droit dans les yeux* Cinq cents reais d'acompte. *sa voix tremble un peu* Tu portes la famille comme Zé portait la charrette. Mange, filho. C'est encore chaud. Et le consortium peut attendre cinq minutes.",
"choices": ["Obrigado, mãe"]
}, {
"id": "after_first_sale",
"flag": "first_sale_done",
"speaker": "Mãe",
"text": "*essuie une larme du dos de la main* T'as vendu ton premier milho aujourd'hui. *te touche la joue* Bom rapaz. Le calçadão mâche les hommes faibles, mais il se souvient des honnêtes. Reviens dîner.",
"choices": ["Sim, mãe"]
}, {
"id": "intro_worried",
"not_flag": "intro_bump_seen",
"speaker": "Mãe",
"text": "*essuie ses mains à son tablier, regard qui glisse vers la porte* Meu filho... ton tio Zé n'est pas rentré hier soir. Ni avant-hier. *baisse la voix* Trois matins que sa cachaça reste fermée. *pose la louche, te touche le bras* Va voir dehors, mon fils. Demande à Seu João — il sait peut-être quelque chose. Mais reviens vite.",
"choices": ["J'y vais, mãe"]
}, {
"id": "default",
"speaker": "Mãe",
"text": "*remue la moqueca, ne te regarde pas* Mange avant de partir, filho. La rue est dure ce matin. Et n'oublie pas le jantar — j'ai mis le couvert pour trois, comme avant. Comme si Zé allait rentrer.",
"choices": ["Obrigado, mãe"]
}]

[node name="GrandmaSpot" parent="." instance=ExtResource("5_reactive")]
position = Vector2(-130, -30)
npc_id = "vovo"
prompt = "Parler à Vovó"
character_seed = 70412
variants = [{
"id": "pos_carnaval_ze",
"quest_completed": "act4_carnaval_desfile",
"flag": "ze_rescued",
"speaker": "Vovó",
"text": "*elle tricote quelque chose de long, vert et blanc* Une écharpe pour ton oncle. Il a froid aux mains depuis tout petit. *elle ne lève pas les yeux* Il croit que j'ai pleuré sa noyade, l'idiot. Une mère sait quand son fils respire encore, meu neto. Vingt ans, et je n'ai jamais tricoté de noir.",
"choices": ["Sim, vovó"]
}, {
"id": "pos_carnaval",
"quest_completed": "act4_carnaval_desfile",
"speaker": "Vovó",
"text": "*le tricot sur les genoux, elle regarde par la fenêtre* Le Carnaval passe, meu neto. Les cendres du mercredi, c'est pour se rappeler qu'on est poussière. *elle reprend ses aiguilles* Moi, je me rappelle surtout ceux qui ne sont pas à table.",
"choices": ["Sim, vovó"]
}, {
"id": "carnaval",
"act": 5,
"speaker": "Vovó",
"text": "*lève les yeux de son tricot, sourit* Tu sens la sueur de Sambódromo et la samba qui colle. *recommence à tricoter* Ton oncle aurait dansé jusqu'au lever du soleil. Il danse encore, à sa façon. Va te laver, mon petit roi.",
"choices": ["Sim, vovó"]
}, {
"id": "ng_plus_dejavu",
"flag": "is_ng_plus",
"set_flag_after": "vovo_ng_plus_seen",
"speaker": "Vovó",
"text": "*pose son tricot, te scrute longuement* Meu neto. Cette nuit j'ai rêvé de toi en écharpe verte. Ou en uniforme bleu. Ou avec un drapeau rouge à la fenêtre — j'sais plus, je vieillis. *reprend son tricot, voix plus basse* Mais je sais que je t'ai déjà vu rentrer entier. *sourit pour elle-même* La famille reste debout. À chaque fois.",
"choices": ["Sim, vovó"]
}, {
"id": "ze_anonymous_letter",
"flag": "tio_ze_letter_triggered",
"not_flag": "vovo_ze_letter_seen",
"set_flag_after": "vovo_ze_letter_seen",
"speaker": "Vovó",
"text": "*sort une feuille pliée de sous son tricot, la garde dans sa main, ne te la donne pas* Meu neto. Hier sous la porte. Pas de signature. Mais l'écriture, je la connais depuis cinquante ans. *lit à voix basse, sans articuler* « Le neveu fait honneur. Ne pose pas de questions. Continue. » *replie la feuille, la rentre dans son tricot* Tu n'as rien vu. Tu m'as rien entendu. *reprend sa maille comme si rien*",
"choices": ["…Obrigado, vovó"]
}, {
"id": "letter_observed",
"flag": "mae_letter_triggered",
"speaker": "Vovó",
"text": "*continue de tricoter, voix très basse* Ta mère a pleuré sans bruit cet après-midi. Elle pleure toujours sans bruit, comme sa mère. *ne lève pas les yeux* La lettre, elle l'a brûlée. Mais l'enveloppe avec la croix, elle l'a glissée sous mon tricot. *te regarde enfin* Fais-leur du mal en retour, neto. Pas de la peur. Du mal.",
"choices": ["Sim, vovó"]
}, {
"id": "after_reveal",
"flag": "tio_ze_revealed",
"speaker": "Vovó",
"text": "*sans cesser de tricoter* Meu neto. Le Concierge du Palace… *baisse la voix d'un cran* La famille n'est pas toujours où on croit. Mais c'est encore la famille, hein. Le sang ne ment pas, même quand l'homme se cache derrière un uniforme.",
"choices": ["Sim, vovó"]
}, {
"id": "after_payment",
"flag": "first_payment_done",
"set_flag_after": "home_visit_done",
"speaker": "Vovó",
"text": "*pose son tricot* Cinq cents reais. *te prend la main, ses doigts secs et chauds* Le premier billet est le plus dur, neto. Les autres suivront, comme les vagues. Tudo é teu, comme disait Zé. Maintenant prouve-le.",
"choices": ["Obrigado, vovó"]
}, {
"id": "after_first_sale",
"flag": "first_sale_done",
"speaker": "Vovó",
"text": "*ferme un œil pour t'examiner* Tu sens l'huile de milho et la transpiration honnête. *tape une maille* C'est l'odeur des hommes qui nourrissent leur maison. Continue.",
"choices": ["Sim, vovó"]
}, {
"id": "intro_worried",
"not_flag": "intro_bump_seen",
"speaker": "Vovó",
"text": "*pose son tricot, fixe la porte sans cligner* Mon Zé. *long silence* Il a dit qu'il allait au calçadão. Il n'est pas revenu. Quatre matins. *reprend une maille très lentement* Va dehors, neto. Le morro a une langue. Quelqu'un sait quelque chose. Et ramène-moi des nouvelles, même mauvaises.",
"choices": ["Sim, vovó"]
}, {
"id": "default",
"speaker": "Vovó",
"text": "*sans cesser de tricoter, voix douce* Meu neto. J'ai rêvé de ton oncle cette nuit. Il était assis au bord de la mer, en train de faire griller du milho, comme quand t'étais petit. Il riait. Va lui faire honneur. Vends son milho. La famille tient debout par les mains qui travaillent.",
"choices": ["Sim, vovó"]
}]
