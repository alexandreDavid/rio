[node name="BetoSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1040, 178)
npc_id = "beto"
prompt = "Parler au gamin"
character_seed = 70499
variants = [{
"id": "found_followup",
"flag": "beto_found",
"speaker": "Beto",
"text": "*range sa valise de lunettes en te voyant, lève les mains* C'est bon, c'est bon, je remonte voir le vieux ! *sourire en coin* Mais avoue qu'elles sont stylées, mes Ray-Ban. Quinze reais, prix sobrinho.",
"choices": ["Remonte, Beto. Tout de suite."]
}, {
"id": "lost",
"flag": "beto_quest_taken",
"set_flag_after": "beto_found",
"actions": {"finish_quest": {"quest": "beto_lost", "objective": "find_beto", "payout": 0}},
"speaker": "Beto",
"text": "*quinze ans, casquette à l'envers, une valise de lunettes de contrefaçon ouverte sur une serviette* Tu veux des lunettes, chef ? Vraies fausses Ray-Ban, dix reais— *te reconnaît, baisse d'un ton* Ah merde. C'est vô Jorge qui t'envoie. *referme la valise à contrecœur* Il capte rien, le vieux. Je gagne plus ici en un jour qu'à trier son poisson en un mois.",
"choices": ["Tu remontes. Maintenant."]
}, {
"id": "default",
"speaker": "Beto",
"text": "*hèle les touristes, valise de lunettes au bras* Óculos, óculos! Lunettes, sunglasses, dez reais, freguês !",
"choices": ["Plus tard, gamin"]
}]

[node name="TraficoContactSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(640, 232)
npc_id = "trafico_contact"
prompt = "Le contact du calçadão"
character_seed = 80101
variants = [{
"id": "a1_drop_pacto",
"flag": "voie_trafico",
"objective_pending": ["trafico_a1_livraison", "drop_calcadao"],
"set_flag_after": "trafico_a1_done",
"actions": {"finish_quest": {"quest": "trafico_a1_livraison", "objective": "drop_calcadao", "payout": 120}, "accept_quest": "trafico_a2_pickup", "rep": {2: 2}},
"speaker": "Contact",
"text": "*assis sur un banc face à la mer, ne te regarde pas* Le paquet de Tito. *tend la main, le fait disparaître sous une serviette* T'as les mains qui tremblent pas, gamin. *glisse des billets* Bien. Miguel veut te tester maintenant — une sacoche t'attend au Copacabana Palace, le groom la garde. Tu la prends, tu la ramènes ici. Tu poses pas de questions sur ce qu'y a dedans.",
"choices": ["J'y vais"]
}, {
"id": "a1_drop_sample",
"not_flag": "voie_trafico",
"objective_pending": ["trafico_a1_livraison", "drop_calcadao"],
"set_flag_after": "trafico_a1_done",
"actions": {"finish_quest": {"quest": "trafico_a1_livraison", "objective": "drop_calcadao", "payout": 120}, "rep": {2: 1}},
"speaker": "Contact",
"text": "*assis sur un banc face à la mer, ne te regarde pas* Le paquet de Tito. *tend la main, le fait disparaître sous une serviette* T'as les mains qui tremblent pas, gamin. *glisse des billets* Bien. Reviens si tu décides de signer avec Tito — pour l'instant tu as juste rendu un service, gamin.",
"choices": ["À bientôt"]
}, {
"id": "a2_close",
"objective_pending": ["trafico_a2_pickup", "pickup_palace"],
"set_flag_after": "trafico_a2_done",
"actions": {"finish_quest": {"quest": "trafico_a2_pickup", "objective": "pickup_palace", "payout": 180}, "accept_quest": "trafico_a3_chauffeur", "rep": {2: 3}},
"speaker": "Contact",
"text": "*récupère la sacoche du Palace, la soupèse, hoche la tête* Miguel avait raison sur toi. *sourire en coin, te file une clé* Maintenant le vrai boulot. Le coffre est chargé près d'ici — tu le conduis à Botafogo, sous le Bondinho. Pas de détour, pas de PM dans le rétro. Quelqu'un t'attend là-bas.",
"choices": ["En route"]
}, {
"id": "a3_remind",
"quest_active": "trafico_a3_chauffeur",
"speaker": "Contact",
"text": "*agacé* Qu'est-ce tu fous encore sur le calçadão ? Botafogo. Le coffre se livre pas tout seul.",
"choices": ["J'y vais"]
}, {
"id": "a4_offer",
"quest_completed": "trafico_a3_chauffeur",
"quest_not_active": "trafico_a4_ipanema",
"quest_not_completed": "trafico_a4_ipanema",
"actions": {"accept_quest": "trafico_a4_ipanema"},
"speaker": "Contact",
"text": "*te tend un sac de sport* Bien joué pour Botafogo. Maintenant tu montes en gamme. Ipanema — y'a un gringo qui paie cash, posto 9. Tu lui refourgues ça, tu prends l'argent, tu disparais. S'il fait l'idiot, tu pars sans discuter.",
"choices": ["Direction Ipanema"]
}, {
"id": "done",
"quest_completed": "trafico_a3_chauffeur",
"speaker": "Contact",
"text": "*te salue d'un menton* Le morro parle de toi maintenant. Tito aussi. Continue comme ça et t'auras plus jamais à vendre de milho.",
"choices": ["À bientôt"]
}, {
"id": "default",
"speaker": "Contact",
"text": "*regarde la mer, ne te calcule pas* Circule, gamin. J'attends quelqu'un.",
"choices": ["…"]
}]

[node name="TraficoTioZeSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1700, 132)
npc_id = "trafico_tioze"
prompt = "Le vieux concierge"
character_seed = 909099
required_flag = "voie_trafico"
variants = [{
"id": "a7_warn",
"objective_pending": ["trafico_a7_tioze", "heed_warning"],
"actions": {"finish_quest": {"quest": "trafico_a7_tioze", "objective": "heed_warning", "payout": 0}, "accept_quest": "trafico_a8_baia", "set_flag": "tio_ze_warned_trafico"},
"speaker": "Le concierge",
"text": "*un vieil homme en uniforme du Palace, il balaie sans te regarder, voix basse* Petit. Te retourne pas. *continue de balayer* Je connaissais ton oncle Zé. Mieux que personne. Il a porté pour Tito, lui aussi. Le morro lui a tout pris, et quand il a voulu partir, Tito l'a brûlé — comme il te brûlera. *te glisse un regard* Tu peux encore choisir de pas finir comme lui. *soupire* Mais tu y retourneras quand même. Alors écoute au moins ça — le gros coup passe par la baie, Niterói, la Mafia da Baía en relais. Réfléchis-y avant la corrida.",
"choices": ["…J'y vais"]
}, {
"id": "default",
"speaker": "Le concierge",
"text": "*balaie le perron du Palace, t'ignore poliment* Bienvenue au Copacabana Palace. *à voix basse, sans lever les yeux* …Toi, je te connais de quelque part.",
"choices": ["…"]
}]

[node name="PoliciaContactSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(520, 232)
npc_id = "policia_contact"
prompt = "L'agent en civil"
character_seed = 80102
variants = [{
"id": "b1_close_pacto",
"flag": "voie_policia",
"objective_pending": ["policia_b1_intel", "report_face"],
"set_flag_after": "policia_b1_done",
"actions": {"finish_quest": {"quest": "policia_b1_intel", "objective": "report_face", "payout": 120}, "accept_quest": "policia_b2_filature", "rep": {1: 3}},
"speaker": "Agent en civil",
"text": "*lit un journal sans le lire, lunettes noires* Ramos t'envoie. *tourne une page* Le type au maillot rayé, près des cocos — c'est un guetteur du morro. T'as bien vu. *note un truc* Le Capitão aime les yeux comme les tiens. *plie son journal* Maintenant le vrai travail : Ramos veut le plan du réseau de Tito — qui livre, qui guette, où. Tu remontes au morro. Ton morro. *te regarde par-dessus ses lunettes* T'as plus de quartier, gamin. T'as un Capitão.",
"choices": ["Je remonte au morro"]
}, {
"id": "b1_close_sample",
"not_flag": "voie_policia",
"objective_pending": ["policia_b1_intel", "report_face"],
"set_flag_after": "policia_b1_done",
"actions": {"finish_quest": {"quest": "policia_b1_intel", "objective": "report_face", "payout": 120}, "rep": {1: 1}},
"speaker": "Agent en civil",
"text": "*lit un journal sans le lire, lunettes noires* Ramos t'envoie. *tourne une page* Le type au maillot rayé, près des cocos — c'est un guetteur du morro. T'as bien vu. *note un truc* Bonne observation, gamin. Si tu décides de bosser pour le Capitão pour de vrai, repasse-le voir au Bar do Policial.",
"choices": ["À bientôt"]
}, {
"id": "default",
"speaker": "Agent en civil",
"text": "*regarde la mer derrière ses lunettes noires* Circulez. Y'a rien à voir.",
"choices": ["…"]
}]

[node name="PoliciaTioZeSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1762, 132)
npc_id = "policia_tioze"
prompt = "Le vieux concierge"
character_seed = 909099
required_flag = "voie_policia"
variants = [{
"id": "b6_warn",
"objective_pending": ["policia_b6_tioze", "hear_concierge"],
"actions": {"finish_quest": {"quest": "policia_b6_tioze", "objective": "hear_concierge", "payout": 0}, "accept_quest": "policia_b7_saisie", "set_flag": "tio_ze_warned_policia"},
"speaker": "Le concierge",
"text": "*vieil homme en uniforme du Palace, balaie sans te regarder* Petit. Te retourne pas. *voix basse* Je connaissais ton oncle Zé. Mieux que personne. Tu nettoies le morro pour Ramos, hein ? *un temps* Et Ramos, il nettoie pour qui ? Le consortium. Les mêmes qui tiennent ta dette. Tu fais le ménage de qui, au juste, sobrinho ? *te glisse un regard, soupire, s'appuie sur son balai* Tu continueras quand même. Alors prends au moins ça : Ramos a son mandat. Une cargaison de la Mafia da Baía passe à Niterói — tu la saisis, au nom de la loi ou de Ramos, c'est selon. Pense à ce que j'ai dit, avant la Madrugada.",
"choices": ["…J'y vais"]
}, {
"id": "default",
"speaker": "Le concierge",
"text": "*balaie le perron du Palace* Bienvenue au Copacabana Palace. *sans lever les yeux* …Toi, je te connais de quelque part.",
"choices": ["…"]
}]

[node name="ConsortiumContactSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(760, 232)
npc_id = "consortium_contact"
prompt = "Le recouvreur de la maison"
character_seed = 80103
variants = [{
"id": "c1_close_pacto",
"flag": "voie_consortium",
"objective_pending": ["consortium_c1_recouvrement", "collect_calcadao"],
"set_flag_after": "consortium_c1_done",
"actions": {"finish_quest": {"quest": "consortium_c1_recouvrement", "objective": "collect_calcadao", "payout": 150}, "accept_quest": "consortium_c2_loyers", "rep": {4: 3}},
"speaker": "Le commerçant",
"text": "*essuie son comptoir, blêmit en te voyant* Vous êtes de chez Magalhães… *sort une enveloppe d'un tiroir, les mains qui tremblent* Tenez. Tout est là, et un petit supplément pour le retard. Dites-leur que ça n'arrivera plus. *te tend un stylo* Et… je signe où, déjà ? *Pas un mot plus haut que l'autre. C'est ça, la maison. Plus loin, le recouvreur plie l'enveloppe dans sa veste :* « Propre. Maintenant tu montes en grade — la tournée des loyers à Barra, le Riserva Uno. Présente-toi à Sr. Magalhães là-bas. »",
"choices": ["Direction Barra"]
}, {
"id": "c1_close_sample",
"not_flag": "voie_consortium",
"objective_pending": ["consortium_c1_recouvrement", "collect_calcadao"],
"set_flag_after": "consortium_c1_done",
"actions": {"finish_quest": {"quest": "consortium_c1_recouvrement", "objective": "collect_calcadao", "payout": 150}, "rep": {4: 1}},
"speaker": "Le commerçant",
"text": "*essuie son comptoir, blêmit en te voyant* Vous êtes de chez Magalhães… *sort une enveloppe d'un tiroir, les mains qui tremblent* Tenez. Tout est là. Dites-leur que ça n'arrivera plus. *Pas un mot plus haut que l'autre. Si tu veux passer pro pour la maison, repasse voir Sr. Magalhães au Riserva Uno.*",
"choices": ["À bientôt"]
}, {
"id": "c8_close",
"objective_pending": ["consortium_c8_menace", "break_holdout"],
"set_flag_after": "consortium_c8_done",
"actions": {"finish_quest": {"quest": "consortium_c8_menace", "objective": "break_holdout", "payout": 1500}, "accept_quest": "consortium_c9_pacto", "pay_debt": 18000, "rep": {4: 6, 0: -5}},
"speaker": "La dernière commerçante",
"text": "*la seule du calçadão qui n'avait pas signé — vieille, droite derrière sa caisse* Mon père a tenu ce kiosque quarante ans sans rien devoir à personne. *te regarde longtemps, puis baisse les yeux, prend le stylo* …Mais j'ai des petits-enfants. *elle signe, sans te regarder. Tu n'as pas levé la voix une seule fois. C'est plus laid comme ça. Le recouvreur range tout, te regarde presque avec respect :* « Le calçadão est à la maison. Magalhães t'attend au Riserva Uno, à Barra — pour la dernière signature. La tienne. »",
"choices": ["Je vais voir Magalhães"]
}, {
"id": "default",
"speaker": "Le recouvreur",
"text": "*compte des billets à l'ombre d'un parasol, sans te regarder* La maison n'a rien à te dire aujourd'hui. Circule.",
"choices": ["…"]
}]

[node name="ConsortiumTioZeSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1648, 132)
npc_id = "consortium_tioze"
prompt = "Le vieux concierge"
character_seed = 909099
required_flag = "voie_consortium"
variants = [{
"id": "c6_warn",
"objective_pending": ["consortium_c6_tioze", "hear_concierge"],
"actions": {"finish_quest": {"quest": "consortium_c6_tioze", "objective": "hear_concierge", "payout": 0}, "accept_quest": "consortium_c7_condos", "set_flag": "tio_ze_warned_consortium"},
"speaker": "Le concierge",
"text": "*vieil homme en uniforme du Palace, balaie sans te regarder* Petit. Te retourne pas. *voix basse* Je connaissais ton oncle Zé. Mieux que personne. Le Consórcio ne t'a jamais prêté un centime — il t'a passé une laisse, et il a appelé ça une dette. J'ai vu comment, jadis. *un temps* Magalhães ne casse pas les jambes. Il casse les gens, lentement, et leur fait signer le constat. *soupire, s'appuie sur son balai* Tu vas signer quand même. Alors prends ça : la maison veut les trois condomínios de Barra alignés d'un coup — c'est le gros morceau, celui qui efface presque ta dette. Souviens-toi de ce que je t'ai dit, quand ce sera ton tour de tenir le stylo.",
"choices": ["…J'y vais"]
}, {
"id": "default",
"speaker": "Le concierge",
"text": "*balaie le perron du Palace* Bienvenue au Copacabana Palace. *sans lever les yeux* …Toi, je te connais de quelque part.",
"choices": ["…"]
}]

[node name="PrefeitoContactSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(880, 232)
npc_id = "prefeito_contact"
prompt = "La table de la pétition"
character_seed = 70401
variants = [{
"id": "d1_close_pacto",
"flag": "voie_prefeito",
"objective_pending": ["prefeito_d1_peticao", "gather_signatures"],
"set_flag_after": "prefeito_d1_done",
"actions": {"finish_quest": {"quest": "prefeito_d1_peticao", "objective": "gather_signatures", "payout": 120}, "accept_quest": "prefeito_d2_basquete", "rep": {0: 4}},
"speaker": "Bénévole de l'orfanato",
"text": "*une table pliante, une pétition, des gosses qui jouent autour* Trois commerçants manquaient — Carlos, la pharmacienne, le kiosque. *tu les as convaincus un par un, sans rien promettre que ta parole* Ils ont signé pour toi, pas pour la mairie. Le Padre va pleurer de joie. *range la pétition précieusement* Le Padre a une autre idée : un tournoi de basket à l'Aterro do Flamengo, pour sortir les gamins de la rue. Du concret, et une belle image pour la campagne. Tu sais parler aux jeunes.",
"choices": ["Direction l'Aterro"]
}, {
"id": "d1_close_sample",
"not_flag": "voie_prefeito",
"objective_pending": ["prefeito_d1_peticao", "gather_signatures"],
"set_flag_after": "prefeito_d1_done",
"actions": {"finish_quest": {"quest": "prefeito_d1_peticao", "objective": "gather_signatures", "payout": 120}, "rep": {0: 1}},
"speaker": "Bénévole de l'orfanato",
"text": "*une table pliante, une pétition, des gosses qui jouent autour* Trois commerçants manquaient. *tu les as convaincus un par un* Ils ont signé pour toi. Le Padre va t'attendre à la chapelle si tu veux porter la cause plus loin.",
"choices": ["À bientôt"]
}, {
"id": "d8_close",
"objective_pending": ["prefeito_d8_campagne", "flip_calcadao"],
"set_flag_after": "prefeito_d8_done",
"actions": {"finish_quest": {"quest": "prefeito_d8_campagne", "objective": "flip_calcadao", "payout": 1500}, "accept_quest": "prefeito_d9_eleicao", "pay_debt": 18000, "rep": {0: 8, 4: -5}},
"speaker": "Le calçadão",
"text": "*tu lis le dossier à voix haute, sur une caisse, devant la foule du calçadão. Au début ils rient. Puis ils écoutent. Les noms, les chiffres, le racket déguisé en dette. Quelqu'un crache vers le Riserva Uno. En une heure le quartier a basculé — pas par peur, par colère juste. Ta dette ? Personne ne te la réclamera plus en public. La vérité l'a effacée mieux qu'aucun paiement.* *Une bénévole arrive en courant, les yeux brillants :* « C'est le moment — l'élection est ce soir. Va retrouver le Padre, c'est lui qui ouvrira le scrutin. Après ça, on ne dira plus le neveu de Zé. On dira Coronel. »",
"choices": ["Je vais voir le Padre"]
}, {
"id": "default",
"speaker": "Bénévole de l'orfanato",
"text": "*fait signer une pétition aux passants, sourit aux enfants* Pour l'orfanato Nossa Senhora, une signature ? *te reconnaît* …Ah, c'est toi. Merci pour tout.",
"choices": ["…"]
}]

[node name="PrefeitoTioZeSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1586, 132)
