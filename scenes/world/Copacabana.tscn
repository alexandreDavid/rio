position = Vector2(760, 96)
script = ExtResource("70_trigger")
npc_id = "consortium_intercept"
speaker = "L'assistant de Magalhães"
text = "*costume clair, il t'emboîte le pas sans te regarder, comme si vous marchiez ensemble depuis toujours* Sr. Magalhães aime accueillir ses nouveaux collaborateurs. *il te tend une chemise cartonnée, propre, sans un pli* Les retards de paiement du calçadão. La maison ne crie jamais — elle passe encaisser. Souriez : la maison, maintenant, c'est vous."
choices = Array[String](["…Compris"])
required_flag = "voie_consortium"
quest_active = "consortium_c1_recouvrement"
fired_flag = "intercept_consortium"

[node name="Shape" type="CollisionShape2D" parent="InterceptConsortium"]
