[node name="LurdesSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(460, 215)
npc_id = "coco_regular"
prompt = "Parler à Dona Lurdes"
character_seed = 80104
variants = [{
"id": "after_envelope",
"quest_completed": "zona_sul_envelope",
"speaker": "Dona Lurdes",
"text": "*sirote son coco à la paille, baisse la voix* Tu sais, sobrinho, on parle aux Postes. La veuve de Leblon — Caldeira — elle cherche encore quelqu'un de fiable. *fait un signe vers le calçadão* Elle paie cash. Elle dit rien. Si tu veux y retourner, le portier connaît ta tête maintenant.",
"choices": ["Obrigado, dona"]
}, {
"id": "evening",
"phase": 2,
"speaker": "Dona Lurdes",
"text": "*remballe son sac, lunettes de soleil retirées* Je rentre, mon petit. La nuit le sable devient méchant — les amoureux, les ivres, les voleurs. *montre le quartier* Tu vois les lampadaires s'allumer ? C'est le signal — Lurdes va voir le journal de huit heures.",
"choices": ["Bonne soirée, dona"]
}, {
"id": "default",
"speaker": "Dona Lurdes",
"text": "*assise sur le sable, t-shirt délavé, coco à la main* Quarante ans que je viens ici, mon fils. Le sable change, le vendeur de coco non. *aspire à la paille* C'est ça la vraie Copacabana — pas les hôtels, pas les touristes.",
"choices": ["Belo, dona"]
}]

[node name="RenatoSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1735, 105)
npc_id = "palace_bellboy"
prompt = "Parler à Renato"
character_seed = 80105
variants = [{
"id": "after_envelope",
"quest_completed": "zona_sul_envelope",
"speaker": "Renato",
"text": "*ajuste sa casquette rouge, regard fuyant, fait mine d'épousseter une valise invisible* Le concierge ? *baisse la voix* Toutes les veuves de Leblon descendent en bas pour lui parler. Sra. Caldeira en premier — trois fois cette semaine. *te scrute* Si tu travailles pour elle, sobrinho, dis-lui : le concierge connaît plus de noms que les juges. Et il commence à les vendre.",
"choices": ["Compris, Renato"]
}, {
"id": "evening",
"phase": 2,
"speaker": "Renato",
"text": "*allume la lanterne au-dessus de la porte du Palace* Le shift de nuit, sobrinho. *brille de l'or* C'est mieux que le jour — les clients donnent des pourboires plus généreux quand ils sortent ivres du bar de l'hôtel. *cligne de l'œil* Reviens vers minuit si tu veux voir qui entre, qui sort.",
"choices": ["Note"]
}, {
"id": "default",
"speaker": "Renato",
"text": "*ajuste sa casquette rouge, sourire d'opérette* Le Palace, sobrinho, c'est trois étages d'histoires qu'on raconte pas. Sinon on perd le job. *te tend une carte mentale* Une nuit ici, c'est huit cents reais. *rit* Compte pas sur moi pour faire une remise.",
"choices": ["Belo"]
}]

