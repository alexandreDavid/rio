"speaker": "Dona Neusa",
"text": "*elle te scanne de la tête aux pieds, pro* Livraisons par l'entrée de service, réclamations à la réception. *demi-sourire* Et le perron vient d'être balayé, moço.",
"choices": ["…"]
}]

[node name="ConsortiumPorteiroSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1748, 8)
npc_id = "consortium_porteiro"
prompt = "Le porteiro de nuit"
character_seed = 815302
