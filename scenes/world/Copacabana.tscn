"actions": {"finish_quest": {"quest": "consortium_c1_recouvrement", "objective": "collect_calcadao", "payout": 150}, "rep": {4: 1}},
"speaker": "Le commerçant",
"text": "*essuie son comptoir, blêmit en te voyant* Vous êtes de chez Magalhães… *sort une enveloppe d'un tiroir, les mains qui tremblent* Tenez. Tout est là. Dites-leur que ça n'arrivera plus. *Pas un mot plus haut que l'autre. Si tu veux passer pro pour la maison, repasse voir Sr. Magalhães au Riserva Uno.*",
"choices": ["À bientôt"]
}, {
"id": "c8_nego",
"objective_pending": ["consortium_c8_menace", "break_holdout"],
"speaker": "La dernière commerçante",
"text": "*la seule du calçadão qui n'avait pas signé — vieille, droite derrière sa caisse. Mais tu regardes mieux : des ardoises de fournisseurs scotchées près du tiroir, les étagères à moitié vides, les mains qui tremblent en comptant la monnaie.* Mon père a tenu ce kiosque quarante ans sans rien devoir à personne. *sa voix se casse une seconde* Personne. *Elle est aux abois — elle ne se bat plus par orgueil, elle se noie et refuse la main tendue de peur qu'on la pousse. Le recouvreur, derrière toi, murmure :* « À toi de jouer. Mais chaque visite ratée, c'est 250 R$ de frais de dossier sur ta paie. »",
"choices": ["Menacer : l'inspection, le bail, la fin — signez", "Racheter : la maison reprend ses ardoises, elle garde sa caisse et son tablier", "Tricher avec la maison : solder ses ardoises de TA poche et la déclarer « insolvable, sans intérêt » (400 R$)"],
"choice_actions": {"0": {"pay_bribe": 250, "rep": {0: -3}}, "1": {"finish_quest": {"quest": "consortium_c8_menace", "objective": "break_holdout", "payout": 1500}, "pay_debt": 18000, "set_flag": "kiosque_absorvido", "rep": {4: 6, 0: -5}}, "2": {"finish_quest": {"quest": "consortium_c8_menace", "objective": "break_holdout", "payout": 0}, "pay_debt": 18000, "set_flag": "kiosque_livre", "pay_bribe": 400, "rep": {4: -3, 0: 6}}}
}, {
"id": "c8_close_livre",
"flag": "kiosque_livre",
"quest_completed": "consortium_c8_menace",
"quest_not_active": "consortium_c9_pacto",
"quest_not_completed": "consortium_c9_pacto",
"actions": {"accept_quest": "consortium_c9_pacto", "debt_credit": 800},
"speaker": "Le recouvreur",
"text": "*le vieux kiosque garde son auvent délavé — le seul du calçadão sans ivoire ni or. Sur le rapport, tu as écrit « insolvable, sans intérêt commercial ». La vieille dame, elle, a trouvé un matin ses ardoises soldées et n'a rien demandé à personne.* « Dossier classé, dit la maison. Le calçadão est aligné. » *Le recouvreur range le rapport sans le relire.* « Magalhães t'attend au Riserva Uno, à Barra. Pour la dernière signature. La tienne. »",
"choices": ["Je vais voir Magalhães"]
}, {
"id": "c8_close",
"quest_completed": "consortium_c8_menace",
"quest_not_active": "consortium_c9_pacto",
"quest_not_completed": "consortium_c9_pacto",
"actions": {"accept_quest": "consortium_c9_pacto", "debt_credit": 800},
"speaker": "Le recouvreur",
"text": "*le kiosque a un auvent neuf ; la vieille dame tient sa caisse, sans dettes et sans liberté. Elle ne te regarde pas.* « Le calçadão est à la maison — et la maison a soldé une belle part de ton ardoise pour la manière. Magalhães t'attend au Riserva Uno, à Barra. Pour la dernière signature. La tienne. »",
"choices": ["Je vais voir Magalhães"]
}, {
"id": "default",
"speaker": "Le recouvreur",
"text": "*compte des billets à l'ombre d'un parasol, sans te regarder* La maison n'a rien à te dire aujourd'hui. Circule.",
"choices": ["…"]
}]

[node name="ConsortiumTioZeSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1648, 132)
npc_id = "consortium_tioze"
prompt = "Le vieux concierge"
character_seed = 909099
required_flag = "voie_consortium"
variants = [{
"id": "c6_mute",
"objective_pending": ["consortium_c6_tioze", "porter_lembranca"],
"speaker": "Le concierge",
"text": "*le vieux balaie le perron ; il a vu ton costume de la maison, le balai change de trottoir* Bienvenue au Copacabana Palace. *deux mots de service, pas un de plus. Les gens du Consórcio, il les sert — il ne leur parle pas.*",
"choices": ["…"]
}, {
"id": "c6_warn",
"objective_pending": ["consortium_c6_tioze", "hear_concierge"],
"objective_done": ["consortium_c6_tioze", "porter_lembranca"],
"actions": {"finish_quest": {"quest": "consortium_c6_tioze", "objective": "hear_concierge", "payout": 0}, "accept_quest": "consortium_c7_condos", "set_flag": "tio_ze_warned_consortium"},
"speaker": "Le concierge",
"text": "*tu lui tends la vieille fiche du Palace — l'écriture appliquée, le faux nom, la photo d'embauche. Le balai s'arrête net. Ses mains se figent dessus ; il regarde la fiche comme on regarde une tombe.* Petit. Te retourne pas. *il te la rend, voix basse* Je connaissais ton oncle Zé. Mieux que personne. Le Consórcio ne t'a jamais prêté un centime — il t'a passé une laisse, et il a appelé ça une dette. J'ai vu comment, jadis. *un temps* Magalhães ne casse pas les jambes. Il casse les gens, lentement, et leur fait signer le constat. *soupire, s'appuie sur son balai* Tu vas signer quand même. Alors prends ça : la maison veut les trois condomínios de Barra alignés d'un coup — c'est le gros morceau, celui qui efface presque ta dette. Souviens-toi de ce que je t'ai dit, quand ce sera ton tour de tenir le stylo.",
"choices": ["…J'y vais"]
}, {
"id": "medalhao_reveal",
"quest_completed": "consortium_c6_tioze",
"not_flag": "tio_ze_revealed",
"actions": {"set_flag": "tio_ze_revealed"},
"speaker": "Le concierge",
"text": "*tu reviens vers le vieux balayeur. Sans un mot, tu sors le médaillon de bois — celui du grand-père, celui que Zé portait avant sa noyade. Le balai s'arrête.* *Il le prend. Le retourne du bon côté sans le regarder, d'un geste qui a quarante ans. Le rend. Ses mains tremblent.* Va-t'en maintenant, sobrinho. *Il ne t'a jamais appelé comme ça. Tu ne demandes rien. Tu sais.*",
"choices": ["…Tio ?"]
}, {
"id": "returned",
"flag": "ze_rescued",
"speaker": "Le concierge",
"text": "*le vieux balayeur est revenu à son poste, plus maigre, le geste intact. La direction n'a pas osé lui demander où il était passé.* *En te voyant, il incline imperceptiblement la tête — rien de plus. Mais le balai s'arrête une seconde entière.*",
"choices": ["…"]
}, {
"id": "vanished",
"flag": "tio_ze_revealed",
"speaker": "Un employé du Palace",
"text": "*un jeune balayeur que tu n'as jamais vu* Le vieux ? Parti il y a trois jours, sans prévenir ni réclamer sa paie. *hausse les épaules* Des types sont passés poser des questions sur lui, après. Le Palace cherche un remplaçant.",
"choices": ["…"]
}, {
"id": "default",
"speaker": "Le concierge",
"text": "*balaie le perron du Palace* Bienvenue au Copacabana Palace. *sans lever les yeux* …Toi, je te connais de quelque part.",
"choices": ["…"]
}]

