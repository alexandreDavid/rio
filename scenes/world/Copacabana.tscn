[node name="InterceptPolicia" type="Area2D" parent="."]
position = Vector2(520, 96)
script = ExtResource("70_trigger")
npc_id = "policia_intercept"
speaker = "L'agent en civil"
text = "*il te tombe dessus au coin de l'Atlântica, journal plié sous le bras, et fait mine de te demander du feu* Le Capitão m'a décrit ta tête. Bonne mémoire, lui. *il tourne une page sans la lire* Le guetteur bosse près des cocos. Tu regardes, tu retiens, tu me rapportes — ici, sur le calçadão. Pas de zèle, pas d'héroïsme. T'es des nôtres maintenant."
choices = Array[String](["Entendu"])
required_flag = "voie_policia"
quest_active = "policia_b1_intel"
fired_flag = "intercept_policia"

