[node name="BetoSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1040, 178)
npc_id = "beto"
prompt = "Parler au gamin"
character_seed = 70499
variants = [{
"id": "found_followup",
"flag": "beto_found",
"speaker": "Beto",
"text": "*range sa valise de lunettes en te voyant, lève les mains* C'est bon, c'est bon, je remonte voir le vieux ! *sourire en coin* Mais avoue qu'elles sont stylées, mes Ray-Ban. Quinze reais, prix sobrinho.",
"choices": ["Remonte, Beto. Tout de suite."]
}, {
"id": "lost",
"flag": "beto_quest_taken",
"set_flag_after": "beto_found",
"actions": {"finish_quest": {"quest": "beto_lost", "objective": "find_beto", "payout": 0}},
"speaker": "Beto",
"text": "*quinze ans, casquette à l'envers, une valise de lunettes de contrefaçon ouverte sur une serviette* Tu veux des lunettes, chef ? Vraies fausses Ray-Ban, dix reais— *te reconnaît, baisse d'un ton* Ah merde. C'est vô Jorge qui t'envoie. *referme la valise à contrecœur* Il capte rien, le vieux. Je gagne plus ici en un jour qu'à trier son poisson en un mois.",
"choices": ["Tu remontes. Maintenant."]
}, {
"id": "default",
"speaker": "Beto",
"text": "*hèle les touristes, valise de lunettes au bras* Óculos, óculos! Lunettes, sunglasses, dez reais, freguês !",
"choices": ["Plus tard, gamin"]
}]

[node name="TraficoContactSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(640, 232)
npc_id = "trafico_contact"
prompt = "Le contact du calçadão"
character_seed = 80101
variants = [{
"id": "a1_drop_pacto",
"flag": "voie_trafico",
"objective_pending": ["trafico_a1_livraison", "drop_calcadao"],
"set_flag_after": "trafico_a1_done",
"actions": {"finish_quest": {"quest": "trafico_a1_livraison", "objective": "drop_calcadao", "payout": 120}, "accept_quest": "trafico_a2_pickup", "rep": {2: 2}, "debt_credit": 200},
"speaker": "Contact",
"text": "*assis sur un banc face à la mer, ne te regarde pas* Le paquet de Tito. *tend la main, le fait disparaître sous une serviette* T'as les mains qui tremblent pas, gamin. *glisse des billets* Bien. Miguel veut te tester maintenant — une sacoche t'attend au Copacabana Palace, le groom la garde. Tu la prends, tu la ramènes ici. Tu poses pas de questions sur ce qu'y a dedans.",
"choices": ["J'y vais"]
}, {
"id": "a1_drop_sample",
"not_flag": "voie_trafico",
"objective_pending": ["trafico_a1_livraison", "drop_calcadao"],
"set_flag_after": "trafico_a1_done",
"actions": {"finish_quest": {"quest": "trafico_a1_livraison", "objective": "drop_calcadao", "payout": 120}, "rep": {2: 1}},
"speaker": "Contact",
"text": "*assis sur un banc face à la mer, ne te regarde pas* Le paquet de Tito. *tend la main, le fait disparaître sous une serviette* T'as les mains qui tremblent pas, gamin. *glisse des billets* Bien. Reviens si tu décides de signer avec Tito — pour l'instant tu as juste rendu un service, gamin.",
"choices": ["À bientôt"]
}, {
"id": "a2_heat",
"objective_done": ["trafico_a2_pickup", "pickup_palace"],
"objective_pending": ["trafico_a2_pickup", "despistar_pm"],
"actions": {"start_chase": {"chaser_id": "pm_copacabana", "speed_start": 128.0, "tire_after_sec": 24.0, "give_up_sec": 45.0, "catch_pct": 0.2, "catch_min": 40, "sprite_seed": "pm_copacabana", "spotted_text": "🚨 La PM t'a reconnu — corre !", "caught_text": "🚨 La PM te serre : « amende » de R$ %d.", "broke_text": "🚨 Serré les poches vides — avertissement.", "escaped_text": "💨 Semé la PM dans les transversales !", "chrono_label": "Despiste a PM !"}},
"speaker": "Contact",
"text": "*siffle entre ses dents sans te regarder* T'es encore chaud, sobrinho — la PM tourne avec ta description. Me colle pas. *fixe la mer* Fais-les tourner en bourrique dans les transversales, sème-les, APRÈS on parle.",
"choices": ["Je les sème"]
}, {
"id": "a3_offer_post_palace",
"quest_completed": "trafico_a2_pickup",
"quest_not_active": "trafico_a3_chauffeur",
"quest_not_completed": "trafico_a3_chauffeur",
"set_flag_after": "trafico_a2_done",
"actions": {"accept_quest": "trafico_a3_chauffeur", "rep": {2: 3}, "debt_credit": 400},
"speaker": "Contact",
"text": "*récupère la sacoche du Palace, la soupèse, hoche la tête* Miguel avait raison sur toi — et t'as semé la PM proprement. *sourire en coin* Tito a fait passer un mot chez Nilton : une part de ta dette vient de sauter. C'est comme ça qu'on paie, nous. *te file une clé* Maintenant le vrai boulot. Le coffre est chargé près d'ici — tu le conduis à Botafogo, sous le Bondinho. Pas de détour, pas de PM dans le rétro. Quelqu'un t'attend là-bas.",
"choices": ["En route"]
}, {
"id": "a2_close",
"objective_pending": ["trafico_a2_pickup", "pickup_palace"],
"speaker": "Contact",
"text": "*ne te regarde pas, soupire* La sacoche, sobrinho. Va la chercher au Palace, le groom l'a posée à l'entrée av. Atlântica. Tu reviens avec.",
"choices": ["J'y vais"]
}, {
"id": "a3_remind",
"quest_active": "trafico_a3_chauffeur",
"speaker": "Contact",
"text": "*agacé* Qu'est-ce tu fous encore sur le calçadão ? Botafogo. Le coffre se livre pas tout seul.",
"choices": ["J'y vais"]
}, {
"id": "a4_offer",
"quest_completed": "trafico_a3_chauffeur",
"quest_not_active": "trafico_a4_ipanema",
"quest_not_completed": "trafico_a4_ipanema",
"actions": {"accept_quest": "trafico_a4_ipanema", "debt_credit": 500},
"speaker": "Contact",
"text": "*te tend un sac de sport* Bien joué pour Botafogo — Tito a encore rogné ta dette chez Nilton, tu montes en gamme. Ipanema — y'a un gringo qui paie cash, posto 9. Tu lui refourgues ça, tu prends l'argent, tu disparais. S'il fait l'idiot, tu pars sans discuter.",
"choices": ["Direction Ipanema"]
}, {
"id": "done",
"quest_completed": "trafico_a3_chauffeur",
"speaker": "Contact",
"text": "*te salue d'un menton* Le morro parle de toi maintenant. Tito aussi. Continue comme ça et t'auras plus jamais à vendre de milho.",
"choices": ["À bientôt"]
}, {
"id": "default",
"speaker": "Contact",
"text": "*regarde la mer, ne te calcule pas* Circule, gamin. J'attends quelqu'un.",
"choices": ["…"]
}]

[node name="InterceptTrafico" type="Area2D" parent="."]
position = Vector2(640, 96)
script = ExtResource("70_trigger")
npc_id = "trafico_intercept"
speaker = "Le contact"
text = "*il se décolle d'un palmier et cale son pas sur le tien, sans te regarder* Te voilà. Tito a passé le mot — le morro descend avec toi maintenant, mermão. *un regard vers le kiosque, l'air de rien* Le paquet, tu le déposes à ma nasse, face mer, comme si tu vendais du milho. Marche naturel. La plage regarde toujours."
choices = Array[String](["Suave"])
required_flag = "voie_trafico"
quest_active = "trafico_a1_livraison"
fired_flag = "intercept_trafico"

[node name="Shape" type="CollisionShape2D" parent="InterceptTrafico"]
