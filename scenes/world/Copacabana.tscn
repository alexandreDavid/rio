[node name="ComicioTribunaSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(820, 96)
npc_id = "prefeito_comicio"
prompt = "La tribune du comício"
character_seed = 70411
required_flag = "voie_prefeito"
variants = [{
"id": "d8_cortejo_close",
"flag": "padre_cortejo",
"objective_pending": ["prefeito_d8_campagne", "cortejo_calcadao"],
"actions": {"finish_quest": {"quest": "prefeito_d8_campagne", "objective": "cortejo_calcadao", "payout": 0}, "set_flag": "padre_cortejo_done"},
"speaker": "Narrateur",
"text": "*La traversée a été le moment. Devant l'église vous étiez deux ; au posto 4 vous étiez trente. Les garçons de boteco sont sortis en tablier, les vendeurs ont laissé leurs nasses, dona Ivone a suivi avec sa cuillère encore à la main. Personne n'a crié de slogan — les gens saluaient le Padre, et restaient. C'est ça, un cortejo : pas une manif, une crue.* *À la tribune, le Padre monte les trois marches, se retourne vers la foule qui remplit le calçadão — et te cherche des yeux.* « C'est lui qui m'a fait descendre. Alors c'est lui que vous allez écouter. »",
"choices": ["*monter à la tribune*"]
}, {
"id": "d8_retencao",
"objective_pending": ["prefeito_d8_campagne", "cortejo_calcadao"],
"speaker": "Militante du comício",
"text": "*l'estrade est montée, la sono grésille, des grappes de curieux attendent en mangeant du milho* T'es le garoto du dossier, né ? *elle regarde derrière toi, cherche quelqu'un* La foule attend le Padre, pas toi. Sans lui, dans dix minutes il ne reste que les mouettes. Remonte à l'église — et redescends AVEC lui, à pied, que tout le calçadão vous voie venir.",
"choices": ["Je vais le chercher"]
}, {
"id": "d8_done",
"flag": "padre_cortejo_done",
"speaker": "Militante du comício",
"text": "*elle tient la foule d'un geste, le Padre debout à la tribune* Il est là, ils sont tous là. *elle te tend le mégaphone du regard* Le quartier n'attend plus que la vérité.",
"choices": ["…"]
}, {
"id": "default",
"speaker": "Militante du comício",
"text": "*elle visse les derniers boulons de l'estrade* Comício ce soir, cidadão. Ramène ta voisine, ramène ta grand-mère — c'est pour eux qu'on la monte, cette tribune.",
"choices": ["…"]
}]

[node name="ZeEveSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(474, 130)
npc_id = "ze_eve"
prompt = "Le vieil homme aux dominos"
character_seed = 909099
required_flag = "ze_rescued"
variants = [{
"id": "pos_desfile",
"quest_completed": "act4_carnaval_desfile",
"not_flag": "ze_pos_desfile_seen",
"set_flag_after": "ze_pos_desfile_seen",
"speaker": "Zé",
"text": "*il pousse la moitié des dominos vers toi, comme d'habitude, puis s'arrête* Je t'ai vu passer, sur l'avenue. Tout en haut des arquibancadas, une casquette sur les yeux pour qu'on ne me reconnaisse pas. *il pose un domino* Ta mère m'a invité samedi. Je ne sais pas encore si j'ai le droit d'y aller. *il te regarde enfin* Tu crois qu'elle m'a pardonné ?",
"choices": ["Elle a mis ton couvert, tio"]
}, {
"id": "contessa_protege",
"flag": "contessa_discreta",
"not_flag": "ze_contessa_seen",
"set_flag_after": "ze_contessa_seen",
"speaker": "Zé",
"text": "*il aligne ses dominos, un journal italien plié sous le bras* La Contessa du quatrième m'a fait monter un café, ce matin. Puis elle a dit au gérant que le vieux concierge était « à son service personnel ». *il hausse les épaules* Depuis, plus personne ne me pose de questions au Palace. *il te regarde par en dessous* C'est toi qui lui as parlé de moi, hein ?",
"choices": ["Elle doit un service, tio"]
}, {
"id": "eve",
"act": 4,
"not_flag": "ze_eve_seen",
"set_flag_after": "ze_eve_seen",
"speaker": "Zé",
"text": "*sur le banc, un vieil homme aligne des dominos, seul. Sans lever la tête, il pousse la moitié du jeu vers toi.* Une partie. *vous jouez en silence. Il gagne. Il sourit.* Ton grand-père disait : le morro descend une fois par an, pour se rappeler qu'il est carioca. *il se lève, remet son chapeau* Demain, la Sapucaí. Ta mère sera dans la foule — troisième rang, côté Apoteose, comme toujours. *il pose deux doigts sur le médaillon, puis sur ton épaule* Vai, sobrinho.",
"choices": ["Vai, tio"]
}, {
"id": "default",
"speaker": "Zé",
"text": "*il mélange les dominos sans hâte, comme quelqu'un qui a tout son temps, pour la première fois depuis des années*",
"choices": ["…"]
}]

[node name="FixerSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(360, -100)
npc_id = "fixer"
prompt = "Le Fixer"
character_seed = 90202
variants = [{
"id": "assassinate_done",
"objective_pending": ["assassinate_consortium", "execute_hit"],
"actions": {"finish_quest": {"quest": "assassinate_consortium", "objective": "execute_hit", "payout": 0}, "pay_debt": 50000, "rep": {2: 8, 0: -10, 1: -10, 4: -20}, "set_flag": "consortium_assassinated"},
"speaker": "Le Fixer",
"text": "*pour la première fois, sourit froidement* C'est fait. Dom Nilton ne déjeune plus. Le consortium n'a plus de tête, le bairro n'a plus de dette. *te rend la moitié de tes 5000* Garde ça — t'en auras besoin pour disparaître quelque temps. Le Carnaval oublie vite, la PM jamais.",
"choices": ["…"]
}, {
"id": "palace_done",
"flag": "palace_heist_loc_done",
"objective_pending": ["act4_palace_heist", "loot_palace_safe"],
"actions": {"finish_quest": {"quest": "act4_palace_heist", "objective": "loot_palace_safe", "payout": 10000}, "pay_debt": 8000, "rep": {2: 5, 1: -3}, "set_flag": "palace_heist_done"},
"speaker": "Le Fixer",
"text": "*ouvre la mallette, compte les billets, sourit pour la première fois* Propre. Le concierge ne s'est aperçu de rien — il l'avouera quand on l'aura promu sous-directeur dans dix ans. *te tend ta part* Voilà 10k, garoto. Et la moitié pour ta dette, comme convenu.",
"choices": ["Bon business"]
}, {
"id": "sambo_done",
"flag": "sambo_loc_done",
"objective_pending": ["act4_sambo_sabotage", "sabotage_rival_float"],
"actions": {"finish_quest": {"quest": "act4_sambo_sabotage", "objective": "sabotage_rival_float", "payout": 12000}, "pay_debt": 10000, "rep": {2: 4, 0: -5, 3: -3}, "set_flag": "sambo_sabotage_done"},
"speaker": "Le Fixer",
"text": "*regarde une vidéo amateur sur son téléphone — un char qui s'effondre, des plumes partout, des passistas en pleurs* …Tu sais qu'il y avait des enfants dans ce char qui le construisaient depuis un an ? *te tend l'enveloppe quand même* 12k. Mon contact est content. Le bairro, moins. Compte là-dessus.",
"choices": ["…J'encaisse"]
}, {
"id": "tio_ze_done",
"flag": "tio_ze_loc_freed",
"objective_pending": ["act4_tio_ze_rescue", "free_tio_ze"],
"actions": {"finish_quest": {"quest": "act4_tio_ze_rescue", "objective": "free_tio_ze", "payout": 0}, "rep": {3: 8, 2: 2}, "set_flag": "tio_ze_rescued"},
"speaker": "Le Fixer",
"text": "*pour la première fois, baisse sa capuche* Tu l'as ramené. *voix plus douce* Je connaissais Zé, jadis — on bossait pour Tito, du même côté. Quand il a voulu partir, ils l'ont pas tué : ils l'ont caché à Niterói comme une dette en suspens. *te serre la main, longuement* C'est pas mon métier de faire ça. C'est le tien.",
"choices": ["Obrigado, Fixer"]
}, {
"id": "press_done",
"flag": "press_loc_done",
"objective_pending": ["act4_press_expose", "deliver_dossier"],
"actions": {"finish_quest": {"quest": "act4_press_expose", "objective": "deliver_dossier", "payout": 8000}, "pay_debt": 6000, "rep": {0: 6, 4: -5}, "set_flag": "press_leaked"},
"speaker": "Le Fixer",
"text": "*lit la une du journal du matin, paie son café* « Consórcio sob suspeita — denúncias chocam o bairro. » *replie le journal, te tend l'enveloppe* 8k, et le bairro respire un peu mieux ce matin. Magalhães, lui, dort moins bien. Bom dia.",
"choices": ["Bom dia"]
}, {
"id": "bondinho_done",
"flag": "bondinho_loc_done",
"objective_pending": ["act4_bondinho_drop", "drop_cash_summit"],
"actions": {"finish_quest": {"quest": "act4_bondinho_drop", "objective": "drop_cash_summit", "payout": 15000}, "pay_debt": 12000, "rep": {4: 4, 1: -3}, "set_flag": "bondinho_drop_done"},
"speaker": "Le Fixer",
"text": "*reçoit un texto, hoche la tête* Mallette livrée, partenaire content. *te tend ta part* 15k, plus propres que la mienne. Le sommet du Bondinho, c'est l'endroit le plus discret de Rio — les touristes filment la baie, pas les hommes.",
"choices": ["Affaire faite"]
}, {
"id": "assassinate_offer",
"act": 4,
"quest_not_active": "assassinate_consortium",
"quest_not_completed": "assassinate_consortium",
"not_flag": "sicario_refused",
"actions": {"accept_quest": "assassinate_consortium", "pay_bribe": 5000, "rep": {2: 2}},
"speaker": "Le Fixer",
"text": "*baisse la voix, voix rauque* Y'a une voie courte, garoto. Un seul coup. Dom Nilton ne déjeune pas demain, et la maison s'effondre — avec ta dette. 5 000 reais d'acompte, le reste est mon affaire. Tu signes en sang, ou tu continues à courir ?",
"choices": ["Je signe (5 000 R$)"]
}, {
"id": "palace_offer",
"act": 4,
"quest_not_active": "act4_palace_heist",
"quest_not_completed": "act4_palace_heist",
"actions": {"accept_quest": "act4_palace_heist"},
"speaker": "Le Fixer",
"text": "*sort un plan plié* Le coffre arrière du Copacabana Palace. Le concierge de nuit me doit un service. Tu rentres par la porte des concierges (av. Atlântica face mer), tu prends ce qu'il y a, tu ressors. 10 000 reais nets, dont 8 pour ta dette si tu veux. Pas d'effraction visible.",
"choices": ["J'y vais"]
}, {
"id": "sambo_offer",
"act": 4,
"quest_not_active": "act4_sambo_sabotage",
"quest_not_completed": "act4_sambo_sabotage",
"actions": {"accept_quest": "act4_sambo_sabotage"},
"speaker": "Le Fixer",
"text": "*pose une enveloppe sur la table* Une école de samba m'a payé pour saccager le char de leur rivale au Sambódromo. Pas de blessés — du carton, des roues, l'image. La presse filme tout, ça fera plus mal que mille reais d'amende. 12 000 reais pour toi.",
"choices": ["Discutable, mais OK"]
}, {
"id": "tio_ze_offer",
"act": 4,
"flag": "tio_ze_revealed",
"quest_not_active": "act4_tio_ze_rescue",
"quest_not_completed": "act4_tio_ze_rescue",
"actions": {"accept_quest": "act4_tio_ze_rescue"},
"speaker": "Le Fixer",
"text": "*hésite, baisse la voix* Garoto… celle-là, je te la fais à l'œil. Le vieux balayeur du Palace — ton oncle. T'es pas le seul à avoir compris. Trois jours après que tu l'as reconnu, la Mafia da Baía est venue le reprendre : une dette en suspens qu'ils gardaient à l'œil depuis sa fuite. Ils le tiennent dans une planque à Niterói. Va le chercher. Pas d'argent en jeu. Juste la famille.",
"choices": ["Je vais le sortir de là"]
}, {
"id": "press_offer",
"act": 4,
"quest_not_active": "act4_press_expose",
"quest_not_completed": "act4_press_expose",
"actions": {"accept_quest": "act4_press_expose"},
"speaker": "Le Fixer",
"text": "*pose un dossier épais sur la table* J'ai chopé ça via un ancien du Consórcio. Noms, comptes off-shore, signatures. Un journaliste anti-corruption attend juste l'enveloppe. 8 000 reais — et un sérieux coup de pied à Magalhães. Tu fais passer ?",
"choices": ["Avec plaisir"]
}, {
"id": "bondinho_offer",
"act": 4,
"quest_not_active": "act4_bondinho_drop",
"quest_not_completed": "act4_bondinho_drop",
"actions": {"accept_quest": "act4_bondinho_drop"},
"speaker": "Le Fixer",
"text": "*te tend une mallette en aluminium* Une opération de blanchiment qui passe par le Bondinho. Tu montes au sommet du Pão de Açúcar avec ça, un partenaire récupère. L'argent ressort lavé, tu touches 15 000 reais. Sois touriste — chemise hawaïenne si tu veux.",
"choices": ["Direction le sommet"]
}, {
"id": "default",
"speaker": "Le Fixer",
"text": "*lit son journal, ne lève pas les yeux* Tout est en cours, garoto. Reviens quand t'as bouclé.",
"choices": ["…"]
}]

