[node name="PoliciaGarcomSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1332, -96)
npc_id = "policia_garcom"
prompt = "Le vieux garçom du bar"
character_seed = 815201
required_flag = "voie_policia"
variants = [{
"id": "b6_temoin",
"objective_pending": ["policia_b6_tioze", "ask_temoin"],
"actions": {"finish_quest": {"quest": "policia_b6_tioze", "objective": "ask_temoin", "payout": 0}},
"speaker": "Le vieux garçom",
"text": "*essuie le même verre depuis dix minutes, devant le Bar do Policial* Le balayeur du Palace ? *baisse la voix* Ici on l'appelait Zé do Morro, dans le temps. Fiché, ramassé deux fois — et le soir, il buvait au comptoir avec ceux qui l'avaient fiché. C'est ça, Copacabana, moleque. *un temps* Mais moi je servais, je sais rien. Va voir Seu Osmar, le PM réformé — le banc du calçadão, côté poste. Trente ans de patrouille, et il garde quelque chose de Zé. Dis-lui que c'est moi qui t'envoie.",
"choices": ["Valeu"]
}, {
"id": "after",
"objective_done": ["policia_b6_tioze", "ask_temoin"],
"speaker": "Le vieux garçom",
"text": "*range son torchon sur l'épaule* Osmar, le banc du calçadão. Et le presse pas — un réformé, ça raconte à son rythme.",
"choices": ["…"]
}, {
"id": "default",
"speaker": "Le vieux garçom",
"text": "*essuie un verre au soleil, devant le bar* Ici c'est le Bar do Policial, freguês. On sert tout le monde — mais on cause qu'aux habitués.",
"choices": ["…"]
}]

[node name="PoliciaOsmarSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1240, 100)
npc_id = "policia_osmar"
prompt = "Le PM réformé"
character_seed = 815202
required_flag = "voie_policia"
variants = [{
"id": "b6_lembranca",
"objective_done": ["policia_b6_tioze", "ask_temoin"],
"objective_pending": ["policia_b6_tioze", "porter_lembranca"],
"actions": {"finish_quest": {"quest": "policia_b6_tioze", "objective": "porter_lembranca", "payout": 0}, "set_flag": "lembranca_policia"},
"speaker": "Seu Osmar",
"text": "*le vieux garçom t'envoie ? Il décroise les bras, tapote le banc à côté de lui* Zé do Morro. J'ai signé sa fiche deux fois, et j'ai bu avec lui cent fois. Cherche pas la logique — trente ans de PM, j'en ai pas trouvé. *il sort de son sac une chope gravée « ZÉ », emballée dans du papier journal* Quand il a disparu, le bar voulait la jeter. Moi je jette pas les hommes. *il te la tend, sans lâcher tout de suite* Le vieux du Palace — tu lui parles pas, tu poses ça devant lui. Un homme peut renier son nom, jamais sa place au comptoir.",
"choices": ["Merci, Seu Osmar"]
}, {
"id": "after",
"objective_done": ["policia_b6_tioze", "porter_lembranca"],
"speaker": "Seu Osmar",
"text": "*regarde la mer, les mains sur les genoux* Alors, il l'a reconnue, sa chope ? *petit rire sans joie* Évidemment. On oublie une tête, jamais une soif.",
"choices": ["…"]
}, {
"id": "default",
"speaker": "Seu Osmar",
"text": "*un vieux costaud, dos droit, regard de patrouille* On se connaît, garoto ? *il te jauge des pieds à la tête, puis retourne à sa mer* Non. Alors bonne journée.",
"choices": ["…"]
}]

[node name="ConsortiumContactSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(760, 232)
npc_id = "consortium_contact"
prompt = "Le recouvreur de la maison"
character_seed = 80103
variants = [{
"id": "c1_close_pacto",
"flag": "voie_consortium",
"objective_pending": ["consortium_c1_recouvrement", "collect_calcadao"],
"set_flag_after": "consortium_c1_done",
"actions": {"finish_quest": {"quest": "consortium_c1_recouvrement", "objective": "collect_calcadao", "payout": 150}, "accept_quest": "consortium_c2_loyers", "debt_credit": 400, "rep": {4: 3}},
"speaker": "Le commerçant",
"text": "*essuie son comptoir, blêmit en te voyant* Vous êtes de chez Magalhães… *sort une enveloppe d'un tiroir, les mains qui tremblent* Tenez. Tout est là, et un petit supplément pour le retard. Dites-leur que ça n'arrivera plus. *te tend un stylo* Et… je signe où, déjà ? *Pas un mot plus haut que l'autre. C'est ça, la maison. Plus loin, le recouvreur plie l'enveloppe dans sa veste :* « Propre. La maison déduit ça de ton ardoise — elle paie toujours ses employés en premier. Maintenant tu montes en grade — la tournée des loyers à Barra, le Riserva Uno. Présente-toi à Sr. Magalhães là-bas. »",
"choices": ["Direction Barra"]
}, {
"id": "c1_close_sample",
"not_flag": "voie_consortium",
"objective_pending": ["consortium_c1_recouvrement", "collect_calcadao"],
"set_flag_after": "consortium_c1_done",
"actions": {"finish_quest": {"quest": "consortium_c1_recouvrement", "objective": "collect_calcadao", "payout": 150}, "rep": {4: 1}},
"speaker": "Le commerçant",
"text": "*essuie son comptoir, blêmit en te voyant* Vous êtes de chez Magalhães… *sort une enveloppe d'un tiroir, les mains qui tremblent* Tenez. Tout est là. Dites-leur que ça n'arrivera plus. *Pas un mot plus haut que l'autre. Si tu veux passer pro pour la maison, repasse voir Sr. Magalhães au Riserva Uno.*",
"choices": ["À bientôt"]
}, {
"id": "c8_nego",
"objective_pending": ["consortium_c8_menace", "break_holdout"],
"speaker": "La dernière commerçante",
"text": "*la seule du calçadão qui n'avait pas signé — vieille, droite derrière sa caisse. Mais tu regardes mieux : des ardoises de fournisseurs scotchées près du tiroir, les étagères à moitié vides, les mains qui tremblent en comptant la monnaie.* Mon père a tenu ce kiosque quarante ans sans rien devoir à personne. *sa voix se casse une seconde* Personne. *Elle est aux abois — elle ne se bat plus par orgueil, elle se noie et refuse la main tendue de peur qu'on la pousse. Le recouvreur, derrière toi, murmure :* « À toi de jouer. Mais chaque visite ratée, c'est 250 R$ de frais de dossier sur ta paie. »",
"choices": ["Flatter : son kiosque est l'âme du calçadão, une légende", "Menacer : l'inspection, le bail, la fin — signez", "Racheter : la maison reprend ses ardoises, elle garde sa caisse et son tablier"],
"choice_actions": {"0": {"pay_bribe": 250, "rep": {0: -2}}, "1": {"pay_bribe": 250, "rep": {0: -3}}, "2": {"finish_quest": {"quest": "consortium_c8_menace", "objective": "break_holdout", "payout": 1500}, "pay_debt": 18000, "set_flag": "consortium_c8_done", "rep": {4: 6, 0: -5}}}
}, {
"id": "c8_close",
"quest_completed": "consortium_c8_menace",
"quest_not_active": "consortium_c9_pacto",
"quest_not_completed": "consortium_c9_pacto",
"actions": {"accept_quest": "consortium_c9_pacto", "debt_credit": 800},
"speaker": "Le recouvreur",
"text": "*le kiosque a un auvent neuf ; la vieille dame tient sa caisse, sans dettes et sans liberté. Elle ne te regarde pas.* « Le calçadão est à la maison — et la maison a soldé une belle part de ton ardoise pour la manière. Magalhães t'attend au Riserva Uno, à Barra. Pour la dernière signature. La tienne. »",
"choices": ["Je vais voir Magalhães"]
}, {
"id": "default",
"speaker": "Le recouvreur",
"text": "*compte des billets à l'ombre d'un parasol, sans te regarder* La maison n'a rien à te dire aujourd'hui. Circule.",
"choices": ["…"]
}]

