"choices": ["…"]
}]

[node name="PrefeitoContactSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(880, 232)
npc_id = "prefeito_contact"
required_act = 2
prompt = "La table de la pétition"
character_seed = 70401
variants = [{
"id": "d1_close_pacto",
"flag": "voie_prefeito",
"objective_pending": ["prefeito_d1_peticao", "gather_signatures"],
"set_flag_after": "prefeito_d1_done",
"actions": {"finish_quest": {"quest": "prefeito_d1_peticao", "objective": "gather_signatures", "payout": 120}, "accept_quest": "prefeito_d2_basquete", "debt_credit": 200, "rep": {0: 4}},
"speaker": "Bénévole de l'orfanato",
"text": "*une table pliante, une pétition, des gosses qui jouent autour* Trois commerçants manquaient — Carlos, la pharmacienne, le kiosque. *tu les as convaincus un par un, sans rien promettre que ta parole* Ils ont signé pour toi, pas pour la mairie. Le Padre va pleurer de joie. Et il a fait passer la quête du dimanche chez Nilton — un petit bout de ta dette en moins, de la part du bairro. *range la pétition précieusement* Le Padre a une autre idée : un tournoi de basket à l'Aterro do Flamengo, pour sortir les gamins de la rue. Du concret, et une belle image pour la campagne. Tu sais parler aux jeunes.",
"choices": ["Direction l'Aterro"]
}, {
"id": "d1_close_sample",
"not_flag": "voie_prefeito",
"objective_pending": ["prefeito_d1_peticao", "gather_signatures"],
"set_flag_after": "prefeito_d1_done",
"actions": {"finish_quest": {"quest": "prefeito_d1_peticao", "objective": "gather_signatures", "payout": 120}, "rep": {0: 1}},
"speaker": "Bénévole de l'orfanato",
"text": "*une table pliante, une pétition, des gosses qui jouent autour* Trois commerçants manquaient. *tu les as convaincus un par un* Ils ont signé pour toi. Le Padre va t'attendre à la chapelle si tu veux porter la cause plus loin.",
"choices": ["À bientôt"]
}, {
"id": "d8_close",
"objective_pending": ["prefeito_d8_campagne", "flip_calcadao"],
"objective_done": ["prefeito_d8_campagne", "cortejo_calcadao"],
"set_flag_after": "prefeito_d8_done",
"actions": {"finish_quest": {"quest": "prefeito_d8_campagne", "objective": "flip_calcadao", "payout": 1500}, "accept_quest": "prefeito_d9_eleicao", "pay_debt": 18000, "rep": {0: 8, 4: -5}},
"speaker": "Le calçadão",
"text": "*le cortège a fait son œuvre : la foule qui t'a suivi depuis l'église est encore là, et le Padre, à la tribune, te cède la place d'un geste — c'est toi qu'ils sont venus entendre.* *Tu lis le dossier à voix haute, sur une caisse, devant la foule du calçadão. Au début ils rient. Puis ils écoutent. Les noms, les chiffres, le racket déguisé en dette. Quelqu'un crache vers le Riserva Uno. En une heure le quartier a basculé — pas par peur, par colère juste. Au premier rang, la mère de Pedrinho tient son fils par la main. C'est elle qui parle la première : « Lui, il a cherché mon gamin quand personne d'autre n'a levé le petit doigt. » Ta dette ? Personne ne te la réclamera plus en public. La vérité l'a effacée mieux qu'aucun paiement.* *Une bénévole arrive en courant, les yeux brillants :* « C'est le moment — l'élection est ce soir. Va retrouver le Padre, c'est lui qui ouvrira le scrutin. Après ça, on ne dira plus le neveu de Zé. On dira Coronel. »",
"choices": ["Je vais voir le Padre"]
}, {
"id": "d8_retencao",
"objective_pending": ["prefeito_d8_campagne", "flip_calcadao"],
"speaker": "Bénévole de l'orfanato",
"text": "*elle voit le dossier sous ton bras, pose une main dessus* Pas comme ça, menino. Tu montes sur une caisse tout seul avec des papiers, le calçadão te regarde deux minutes et retourne à ses affaires — et le consortium saura tout avant ce soir. *elle désigne l'église, là-haut* Le bairro écoute quand le bairro marche derrière quelqu'un. Va chercher le Padre. Descends avec lui, en cortège, du parvis jusqu'ici. Après, ils entendront chaque mot.",
"choices": ["Je vais à l'église"]
}, {
"id": "default",
"speaker": "Bénévole de l'orfanato",
"text": "*fait signer une pétition aux passants, sourit aux enfants* Pour l'orfanato Nossa Senhora, une signature ? *te reconnaît* …Ah, c'est toi. Merci pour tout.",
"choices": ["…"]
}]

