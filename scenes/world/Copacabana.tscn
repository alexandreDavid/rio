[node name="InterceptPrefeito" type="Area2D" parent="."]
position = Vector2(1500, -70)
script = ExtResource("70_trigger")
npc_id = "prefeito_intercept"
speaker = "Le sacristain"
text = "*il te rattrape en trottinant sur le parvis, tout essoufflé* Espera aí ! Le Padre a annoncé la pétition à la messe de sept heures — la moitié du calçadão t'attend déjà, et l'autre moitié fait semblant de ne pas attendre. *il te glisse un stylo dans la main* Prends au moins ça. C'est celui des registres de baptême — il n'a jamais écrit un mensonge."
choices = Array[String](["Obrigado"])
required_flag = "voie_prefeito"
quest_active = "prefeito_d1_peticao"
fired_flag = "intercept_prefeito"

[node name="Shape" type="CollisionShape2D" parent="InterceptPrefeito"]
