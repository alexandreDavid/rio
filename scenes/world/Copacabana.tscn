[node name="TraficoTioZeSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(1700, 132)
npc_id = "trafico_tioze"
prompt = "Le vieux concierge"
character_seed = 909099
required_flag = "voie_trafico"
variants = [{
"id": "a7_mute",
"objective_pending": ["trafico_a7_tioze", "porter_lembranca"],
"speaker": "Le concierge",
"text": "*le vieux balaie le perron, méthodique ; le balai contourne tes pieds sans ralentir* Bienvenue au Copacabana Palace. *rien d'autre. Ce silence-là ne se force pas — il se mérite.*",
"choices": ["…"]
}, {
"id": "a7_warn",
"objective_pending": ["trafico_a7_tioze", "heed_warning"],
"objective_done": ["trafico_a7_tioze", "porter_lembranca"],
"actions": {"finish_quest": {"quest": "trafico_a7_tioze", "objective": "heed_warning", "payout": 0}, "accept_quest": "trafico_a8_baia", "set_flag": "tio_ze_warned_trafico", "debt_credit": 800},
"speaker": "Le concierge",
"text": "*tu tends la photo de la colônia — Zé jeune, un filet plein sur l'épaule, le sourire des jours de belle pêche. Le balai s'arrête net. Le vieux se fige, regarde la photo, puis toi, longtemps.* Petit. Te retourne pas. *il reprend son balai, voix basse* Je connaissais ton oncle Zé. Mieux que personne. Il a porté pour Tito, lui aussi. Le morro lui a tout pris, et quand il a voulu partir, Tito l'a brûlé — comme il te brûlera. *te glisse un regard* Tu peux encore choisir de pas finir comme lui. *soupire* Mais tu y retourneras quand même. Alors écoute au moins ça — le gros coup passe par la baie, Niterói, la Mafia da Baía en relais. Réfléchis-y avant la corrida.",
"choices": ["…J'y vais"]
}, {
"id": "medalhao_reveal",
"quest_completed": "trafico_a7_tioze",
"not_flag": "tio_ze_revealed",
"actions": {"set_flag": "tio_ze_revealed"},
"speaker": "Le concierge",
"text": "*tu reviens vers le vieux balayeur. Sans un mot, tu sors le médaillon de bois — celui du grand-père, celui que Zé portait avant sa noyade. Le balai s'arrête.* *Il le prend. Le retourne du bon côté sans le regarder, d'un geste qui a quarante ans. Le rend. Ses mains tremblent.* Va-t'en maintenant, sobrinho. *Il ne t'a jamais appelé comme ça. Tu ne demandes rien. Tu sais.*",
"choices": ["…Tio ?"]
}, {
"id": "returned",
"flag": "ze_rescued",
"speaker": "Le concierge",
"text": "*le vieux balayeur est revenu à son poste, plus maigre, le geste intact. La direction n'a pas osé lui demander où il était passé.* *En te voyant, il incline imperceptiblement la tête — rien de plus. Mais le balai s'arrête une seconde entière.*",
"choices": ["…"]
}, {
"id": "vanished",
"flag": "tio_ze_revealed",
"speaker": "Un employé du Palace",
"text": "*un jeune balayeur que tu n'as jamais vu* Le vieux ? Parti il y a trois jours, sans prévenir ni réclamer sa paie. *hausse les épaules* Des types sont passés poser des questions sur lui, après. Le Palace cherche un remplaçant.",
"choices": ["…"]
}, {
"id": "default",
"speaker": "Le concierge",
"text": "*balaie le perron du Palace, t'ignore poliment* Bienvenue au Copacabana Palace. *à voix basse, sans lever les yeux* …Toi, je te connais de quelque part.",
"choices": ["…"]
}]

[node name="TraficoFirminoSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(240, 330)
npc_id = "trafico_firmino"
prompt = "Le pêcheur de la colônia"
character_seed = 815102
required_flag = "voie_trafico"
variants = [{
"id": "a7_lembranca",
"objective_done": ["trafico_a7_tioze", "ask_temoin"],
"objective_pending": ["trafico_a7_tioze", "porter_lembranca"],
"actions": {"finish_quest": {"quest": "trafico_a7_tioze", "objective": "porter_lembranca", "payout": 0}, "set_flag": "lembranca_trafico"},
"speaker": "Seu Firmino",
"text": "*il t'écoute dire le nom de dona Zilda, hoche la tête, pose sa nasse* Si c'est elle qui t'envoie, senta aí. *il fouille sous le banc de sa barque, en sort une photo cornée, protégée par un sachet plastique* La colônia, l'année du grand banc de tainha. Le deuxième en partant de la gauche, avec le filet — c'est Zé. Il riait encore, à l'époque. Avant de porter pour l'autre, là-haut. *il te la met dans la main, referme tes doigts dessus* Le vieux du Palace, tu lui parles pas. Tu lui montres ça, sans un mot, et tu laisses le silence travailler. Un homme qui a fui la mer reconnaît toujours sa marée.",
"choices": ["Valeu, Seu Firmino"]
}, {
"id": "after",
"objective_done": ["trafico_a7_tioze", "porter_lembranca"],
"speaker": "Seu Firmino",
"text": "*répare son filet, un œil sur la houle* Alors, le vieux a parlé ? *hoche la tête sans attendre la réponse* La photo, tu la gardes. Ici on rend pas les souvenirs, on les confie.",
"choices": ["…"]
}, {
"id": "default",
"speaker": "Seu Firmino",
"text": "*il te jauge une seconde, puis retourne à sa nasse* …T'es qui, toi ? *il démêle un nœud sans te regarder* La colônia parle pas aux pressés. Reviens quand quelqu'un d'ici saura ton nom.",
"choices": ["…"]
}]

[node name="PoliciaContactSpot" parent="." instance=ExtResource("62_reactive")]
position = Vector2(520, 232)
npc_id = "policia_contact"
prompt = "L'agent en civil"
character_seed = 80102
variants = [{
"id": "b1_close_pacto",
"flag": "voie_policia",
"objective_pending": ["policia_b1_intel", "report_face"],
"set_flag_after": "policia_b1_done",
"actions": {"finish_quest": {"quest": "policia_b1_intel", "objective": "report_face", "payout": 120}, "accept_quest": "policia_b2_filature", "rep": {1: 3}},
"speaker": "Agent en civil",
"text": "*lit un journal sans le lire, lunettes noires* Ramos t'envoie. *tourne une page* Le type au maillot rayé, près des cocos — c'est un guetteur du morro. T'as bien vu. *note un truc* Le Capitão aime les yeux comme les tiens. *plie son journal* Maintenant le vrai travail : Ramos veut le plan du réseau de Tito — qui livre, qui guette, où. Tu remontes au morro. Ton morro. *te regarde par-dessus ses lunettes* T'as plus de quartier, gamin. T'as un Capitão.",
"choices": ["Je remonte au morro"]
}, {
"id": "b1_close_sample",
"not_flag": "voie_policia",
"objective_pending": ["policia_b1_intel", "report_face"],
"set_flag_after": "policia_b1_done",
"actions": {"finish_quest": {"quest": "policia_b1_intel", "objective": "report_face", "payout": 120}, "rep": {1: 1}},
"speaker": "Agent en civil",
"text": "*lit un journal sans le lire, lunettes noires* Ramos t'envoie. *tourne une page* Le type au maillot rayé, près des cocos — c'est un guetteur du morro. T'as bien vu. *note un truc* Bonne observation, gamin. Si tu décides de bosser pour le Capitão pour de vrai, repasse-le voir au Bar do Policial.",
"choices": ["À bientôt"]
}, {
"id": "default",
"speaker": "Agent en civil",
"text": "*regarde la mer derrière ses lunettes noires* Circulez. Y'a rien à voir.",
"choices": ["…"]
}]

