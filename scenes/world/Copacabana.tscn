position = Vector2(1300, 115)
npc_id = "calcadao_fotografo"
prompt = "Parler au photographe"
character_seed = 80305
variants = [{
"id": "offer",
"quest_not_active": "cristo_photo",
"quest_not_completed": "cristo_photo",
"actions": {"accept_quest": "cristo_photo"},
"speaker": "Photographe (calçadão)",
"text": "*appareil photo en bandoulière, café froid, cernes profonds* Sobrinho. J'ai un éditorial à boucler ce midi : Cristo au mirante, vue large, pas mes 30 derniers Cristo bookés. Je suis crevé. Monte au Corcovado, déclenche depuis le point sud, ramène la carte SD. 1000 reais cash.",
"choices": ["Je monte"]
}, {
"id": "in_progress",
"quest_active": "cristo_photo",
"speaker": "Photographe (calçadão)",
"text": "*serre son café* Le mirante, freguês. Avant midi, sinon le mag part sans moi.",
