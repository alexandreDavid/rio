[node name="CagarrasPescadorSpot" parent="." instance=ExtResource("9_reactive")]
position = Vector2(80, 130)
npc_id = "cagarras_pescador"
prompt = "Parler au vieux pêcheur"
character_seed = 80403
variants = [{
"id": "return",
"objective_done": ["cagarras_chain", "recover_chain"],
"objective_pending": ["cagarras_chain", "return_chain"],
"actions": {"finish_quest": {"quest": "cagarras_chain", "objective": "return_chain", "payout": 0}, "rep": {0: 2}},
"speaker": "Seu Bento (pêcheur)",
"text": "*pose son filet, prend la chaîne dans ses mains tannées, le menton qui tremble* Minha mãe. *embrasse le médaillon* Quarante ans qu'elle est morte, et c'est tout ce que j'avais d'elle. Tu sais nager, sobrinho. Tu sais aussi comme on se sent à mon âge ? Obrigado, mon fils.",
"choices": ["De rien, Seu Bento"]
}, {
"id": "in_progress",
"quest_active": "cagarras_chain",
"speaker": "Seu Bento (pêcheur)",
"text": "*pointe vers le large* La grande île, côté sud, près du récif blanc. C'est là que je l'ai perdue. Le SUP du Posto 6 te mènera là-bas.",
"choices": ["J'y vais"]
}, {
"id": "offer",
"quest_not_active": "cagarras_chain",
"quest_not_completed": "cagarras_chain",
"actions": {"accept_quest": "cagarras_chain"},
"speaker": "Seu Bento (pêcheur)",
"text": "*70 ans, mains tannées, te regarde sans te quitter des yeux* Sobrinho. La semaine dernière, j'ai perdu la chaîne en or de ma mère — tombée à l'eau près des îles Cagarras, côté récif blanc. Je sais plus plonger. Toi tu sais. 1500 reais si tu la ramènes.",
"choices": ["Je te la ramène"]
}, {
"id": "done",
"quest_completed": "cagarras_chain",
"speaker": "Seu Bento (pêcheur)",
"text": "*porte la chaîne autour du cou, regarde la mer* Elle est de retour. Toi aussi, quand tu veux.",
"choices": ["Bonne pêche"]
}, {
"id": "default",
"speaker": "Seu Bento (pêcheur)",
"text": "*remaille son filet sans lever les yeux* La mer rend rarement ce qu'elle prend. Mais elle prête.",
"choices": ["…"]
}]

[node name="CagarrasChainDiveSpot" parent="." instance=ExtResource("9_reactive")]
position = Vector2(260, 30)
npc_id = "cagarras_recife"
prompt = "Plonger depuis le bord (récif blanc)"
character_seed = 80404
variants = [{
"id": "finish",
"objective_pending": ["cagarras_chain", "recover_chain"],
"actions": {"finish_quest": {"quest": "cagarras_chain", "objective": "recover_chain", "payout": 0}, "rep": {0: 1}},
"speaker": "Narrateur",
"text": "*Tu descends sur le sable, regardes le récif blanc au loin — la première île, côté sud. Plouf. L'eau est plus froide qu'à Copa, plus claire aussi. Tu nages cinquante mètres, prends ton souffle, plonges. Au pied du récif, prise dans une fente, la chaîne brille faiblement — un grain de soleil sous la mer. Tu la dégages, tu remontes. Une raie passe, indifférente. Retour à la nage.*",
"choices": ["Refaire surface"]
}, {
"id": "after",
"quest_completed": "cagarras_chain",
"speaker": "Narrateur",
"text": "*Le récif blanc, vide cette fois. Une raie passe, indifférente. La mer n'a plus rien à te dire ici.*",
"choices": ["Remonter au SUP"]
}, {
"id": "default",
"speaker": "Narrateur",
"text": "*Eau claire, fond rocheux, poissons argentés. Joli mais sans raison particulière de plonger.*",
"choices": ["Continuer"]
}]

