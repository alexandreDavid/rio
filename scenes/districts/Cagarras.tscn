[node name="TraficoCagarrasSpot" parent="." instance=ExtResource("9_reactive")]
position = Vector2(-220, 168)
npc_id = "trafico_cagarras"
prompt = "Le passeur (bateau)"
character_seed = 80110
variants = [{
"id": "a6_close",
"objective_pending": ["trafico_a6_cagarras", "receive_cargo"],
"set_flag_after": "trafico_a6_done",
"actions": {"finish_quest": {"quest": "trafico_a6_cagarras", "objective": "receive_cargo", "payout": 600}, "accept_quest": "trafico_a7_tioze", "pay_debt": 4000, "rep": {2: 5}},
"speaker": "Le passeur",
"text": "*tire une barque sur les rochers, des caisses bâchées dessous* T'es l'homme de Tito ? *décharge sans te regarder* Vingt caisses. Tu signes rien, tu comptes rien, tu te souviens de rien. *crache dans l'eau, range ses cordages, hésite* Un dernier truc — un vieux concierge du Copacabana Palace m'a payé pour te passer un mot. Il veut te voir. Il dit que c'est au sujet de ton oncle. Moi je transmets, c'est tout.",
"choices": ["J'irai au Palace"]
}, {
"id": "default",
"speaker": "Pêcheur",
"text": "*répare un filet face aux îles Cagarras* Belas ilhas, né? Os golfinhos passam de manhã. *ne t'accorde pas un regard de plus*",
"choices": ["…"]
}]


