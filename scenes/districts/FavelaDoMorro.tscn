[node name="VovoSpot" parent="." unique_id=289418179 instance=ExtResource("7_reactive")]
position = Vector2(40, -360)
npc_id = "vovo_morro"
prompt = "Parler à la vovó"
variants = Array[Dictionary]([{
"actions": {
"finish_quest": {
"objective": "ask_vovo",
"payout": 0,
"quest": "prologue_pedrinho"
}
},
"choices": ["Je remonte chercher Juca"],
"id": "prologue_vovo",
"objective_done": ["prologue_pedrinho", "ask_mae"],
"objective_pending": ["prologue_pedrinho", "ask_vovo"],
"speaker": "Vovó do morro",
"text": "*pose son tricot, te fixe par-dessus ses lunettes* Le petit Pedrinho. *hoche lentement la tête* Je l'ai vu filer vers le haut, vers la chapelle, avant l'aube — comme s'il avait le diable au cul. Et l'homme en costume clair derrière, qui demandait après lui et après les dettes de sa mère. *reprend une maille* Le petit Juca jouait avec lui hier — c'est lui qui sait où Pedrinho se terre. Tu le trouveras sur les marches, en remontant le morro, avec sa balle."
}, {
"choices": ["Obrigado, vovó"],
"id": "after_envelope",
"quest_completed": "zona_sul_envelope",
"speaker": "Vovó do morro",
"text": "*pose son tricot, te scrute par-dessus ses lunettes* Sobrinho. *baisse la voix* Une de mes cousines fait des ménages à Leblon — chez les Caldeira, justement. *reprend une maille très lentement* Elle a entendu ton prénom dans la bouche de la veuve. Pas en mal, hein, au contraire. *léger sourire édenté* La rumeur monte ici comme la fumée du milho — elle ressort en haut. Mais fais gaffe, mon petit. Les gens chic se rappellent les visages utiles. Tu vas en revoir d'autres, des enveloppes."
}, {
"choices": ["Boa noite, vovó"],
"id": "evening",
"phase": 2,
"speaker": "Vovó do morro",
"text": "*allume une lanterne à pétrole, tricote toujours dans le halo orange* Sobrinho. *voix plus douce que d'habitude* Le soir, le morro chante autrement. Tu entends ? *un chien aboie au loin, une radio passe Garota de Ipanema deux blocs plus bas* C'est l'heure où les vieilles tricotent et où les jeunes vont commencer à perdre leurs sous au bar. Rentre pas trop tard chez ta mère, elle s'inquiète."
}, {
"choices": ["Belo, vovó"],
"id": "default",
"speaker": "Vovó do morro",
"text": "*tricote sans lever les yeux, voix douce* Sobrinho, t'as vu mes mains ? Soixante-douze ans qu'elles tricotent. Si elles s'arrêtent, c'est que je suis morte. *rit silencieusement* Tu reviens t'asseoir quand tu veux. Y'a toujours du café."
}])
