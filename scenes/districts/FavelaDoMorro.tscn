[node name="OperacaoMadrugadaSpot" parent="." instance=ExtResource("7_reactive")]
position = Vector2(40, -420)
npc_id = "operacao_madrugada"
required_act = 2
prompt = "Le point de ralliement de la PM"
character_seed = 90208
variants = [{
"id": "madrugada",
"flag": "madrugada_lancee",
"objective_pending": ["policia_b9_madrugada", "complete_madrugada"],
"actions": {"finish_quest": {"quest": "policia_b9_madrugada", "objective": "complete_madrugada", "payout": 5000}, "rep": {1: 10}, "set_endgame": "POLICIA"},
"speaker": "Operação Madrugada",
"text": "*4h47. Le morro retient son souffle. Ramos lève deux doigts — les colonnes de la PM montent les escadarias en silence, et toi tu montes avec elles, gilet trop grand, cœur trop fort.* *Ça dure quatre heures. Trois caches tombent. Personne ne tire. Quand le soleil touche les toits, Ramos pose sa main sur ton épaule, devant tous ses hommes :* « Le bairro saura à qui il doit sa paix. Chefe. »",
"choices": ["*regarder le soleil se lever sur le morro*"]
}, {
"id": "default",
"speaker": "PM en faction",
"text": "*adossé au mur, radio qui grésille* Circule, irmão. Y a rien à voir ici. *il regarde ailleurs* Pas encore.",
"choices": ["…"]
}]

[node name="PoliciaFilatureSpot" parent="." unique_id=185039548 instance=ExtResource("7_reactive")]
position = Vector2(26, -486)
npc_id = "policia_filature"
required_act = 2
prompt = "Observer le réseau (planque)"
variants = Array[Dictionary]([{
"actions": {
"start_stakeout": {
"quest": "policia_b2_filature",
"objective": "map_network",
"duration": 20.0,
"seed": "olheiro_b2_morro"
}
},
"choices": ["Je le prends en filature"],
"id": "b2_filature",
"objective_pending": ["policia_b2_filature", "map_network"],
"speaker": "Narrateur",
"text": "*Depuis ce recoin, tu le repères : l'olheiro de Tito entame sa tournée — les caches, les guetteurs, les horaires. Tout le réseau tient dans ses allées et venues.* *La radio grésille, voix de l'agent :* « Le voilà. Tu le suis, sobrinho. Ni trop près — il t'a vu grandir, il te reconnaîtrait — ni trop loin, ou tu perds le fil. Juste le temps de monter le dossier. S'il te grille ou s'il t'échappe, tu laisses couler et tu reviens à la planque. »"
}, {
"actions": {
"accept_quest": "policia_b3_escorte",
"debt_credit": 400,
"rep": {
1: 5,
2: -4
}
},
"choices": ["En route pour Botafogo"],
"id": "b2_close",
"quest_completed": "policia_b2_filature",
"quest_not_active": "policia_b3_escorte",
"quest_not_completed": "policia_b3_escorte",
"set_flag_after": "policia_b2_done",
"speaker": "Narrateur",
"text": "*Tu plies le carnet : chaque visage, chaque horaire. Des gens qui t'ont vu grandir. C'est fait — et ça ne se défait pas. Le morro ne le sait pas encore.* *La radio grésille, voix de l'agent :* « Le carnet est en or. Le Capitão a fait glisser un mot chez Nilton — une part de ta dette vient de sauter. Maintenant il veut que tu conduises une patrouille en planque — Botafogo, sous le Bondinho. Discrète. File. »"
}, {
"choices": ["M'éloigner"],
"id": "default",
"speaker": "Narrateur",
"text": "*Un recoin tranquille du morro. D'ici on voit les marches monter et descendre. Rien à signaler pour l'instant.*"
}])
character_seed = 80107

[node name="FamiliaConflitoSpot" parent="." instance=ExtResource("7_reactive")]
position = Vector2(-140, -250)
npc_id = "familia_conflito"
required_act = 2
prompt = "Dona Cléo (la famille)"
character_seed = 70441
variants = [{
"id": "d3_familia",
"objective_pending": ["prefeito_d3_mediation", "ouvir_familia"],
"actions": {"finish_quest": {"quest": "prefeito_d3_mediation", "objective": "ouvir_familia", "payout": 0}, "rep": {0: 1}},
"speaker": "Dona Cléo",
"text": "*devant sa porte, un balai serré comme une arme, les yeux rouges* C'est le Padre qui t'envoie ? Alors écoute bien. Neném veut MA laje pour poster son olheiro — ma laje, où sèche le linge de mes trois gosses. *sa voix casse* Le pire ? Je l'ai VU grandir, ce menino. Il jouait au futebol avec mon aîné, il mangeait à ma table quand sa mère faisait des ménages en ville. *elle attrape ta manche, baisse la voix* Écoute-moi : Neném fait ça parce qu'on lui a donné un ordre, pas parce qu'il le veut. Menace-le pas, il peut plus reculer devant une menace. Mais la laje du bar de Nino, deux ruelles plus haut — plus haute que la mienne, vide depuis que Nino est parti à Caxias. Offre-lui ça. Donne-lui une porte de sortie, il la prendra.",
"choices": ["Je vais lui parler"]
}, {
"id": "d3_familia_apos",
"objective_done": ["prefeito_d3_mediation", "ouvir_familia"],
"objective_pending": ["prefeito_d3_mediation", "defuse_conflict"],
"speaker": "Dona Cléo",
"text": "*guette la ruelle depuis sa porte* Tu lui as parlé ? La laje de Nino, sobrinho — rappelle-toi. Pas de menace.",
"choices": ["J'y travaille"]
}, {
"id": "default",
"speaker": "Habitante du morro",
"text": "*étend du linge entre deux fenêtres* Tudo em paz por aqui hoje, graças a Deus. *te salue de la tête*",
"choices": ["…"]
}]

[node name="CapangaTitoSpot" parent="." instance=ExtResource("7_reactive")]
position = Vector2(20, -248)
npc_id = "capanga_nenem"
required_act = 2
prompt = "Neném (l'homme de Tito)"
character_seed = 70442
variants = [{
"id": "d3_capanga",
"objective_done": ["prefeito_d3_mediation", "ouvir_familia"],
"objective_pending": ["prefeito_d3_mediation", "ouvir_capanga"],
"speaker": "Neném",
"text": "*adossé au mur en face de chez Dona Cléo, jeune, la mâchoire crispée, il te jauge* Le type du Padre, c'est ça ? *il crache par terre, mais sans conviction* J'ai un ordre : un olheiro sur une laje haute, côté escadaria. C'est pas une envie, c'est un ORDRE — tu sais ce que ça veut dire, ici ? *ses yeux glissent malgré lui vers la porte de Dona Cléo, puis reviennent sur toi, durs* Alors dis ce que t'as à dire, et dis-le bien.",
"choices": ["Le Padre te demande de reculer — fais-le pour lui", "Recule, ou t'auras la PM et tout le morro sur le dos", "La laje du bar de Nino — plus haute, personne dessus. T'exécutes ton ordre sans toucher à la femme qui t'a nourri"],
"choice_actions": {"0": {"rep": {0: -1}}, "1": {"rep": {0: -1}}, "2": {"finish_quest": {"quest": "prefeito_d3_mediation", "objective": "ouvir_capanga", "payout": 0}, "set_flag": "d3_capanga_ouvido", "rep": {0: 2}}}
}, {
"id": "d3_capanga_mudo",
"objective_pending": ["prefeito_d3_mediation", "ouvir_capanga"],
"speaker": "Neném",
"text": "*adossé au mur, il te regarde approcher et secoue la tête* Je te connais pas, et je parle pas aux inconnus qui débarquent au milieu d'une embrouille. *il désigne la porte d'en face du menton* Si t'es venu pour cette histoire, va d'abord écouter Dona Cléo. Après on verra si tu comprends quelque chose au morro.",
"choices": ["D'accord"]
}, {
"id": "memoria_poupado",
"flag": "nenem_poupado",
"speaker": "Neném",
"text": "*tu le devines là-haut, sur la laje du bar de Nino, silhouette immobile face à la baie. En te voyant passer dans la ruelle, il te salue du menton — une fois, sec. Chez Dona Cléo, le linge sèche tranquille.*",
"choices": ["…"]
}, {
"id": "memoria_protegido",
"flag": "nenem_protegido",
"speaker": "Dona Cléo",
"text": "*elle étend son linge, apaisée* Tu sais où il est, Neném ? Au parvis — il balaie pour le Padre, il dort à la sacristie. *elle baisse la voix* Les gens de Tito sont passés deux fois demander après lui. Le Padre les a reçus à la porte, tout sourire, et ils sont repartis. Pour l'instant. *elle te serre le bras* T'as sorti un gosse du jeu, sobrinho. Prie pour que ça tienne.",
"choices": ["…"]
}, {
"id": "memoria_dedurado",
"flag": "nenem_dedurado",
"speaker": "Dona Cléo",
"text": "*le mur d'en face est vide. Dona Cléo étend son linge, mais quand elle te voit, elle rentre le panier et ferme à demi sa porte* …La PM est montée le lendemain de ta « médiation ». Ils ont pris Neném devant sa mère. *un temps* Ma laje est tranquille, oui. Tout le morro est très, très tranquille quand tu passes, maintenant.",
"choices": ["…"]
}, {
"id": "default",
"speaker": "Jeune du morro",
"text": "*fait rebondir une balle contre le mur, l'œil ailleurs* Suave, parceiro. *te salue du menton*",
"choices": ["…"]
}]

