[node name="SamboCostumeiraSpot" parent="." instance=ExtResource("7_reactive")]
position = Vector2(-200, 100)
npc_id = "sambo_costumeira"
prompt = "Parler à la costumière en chef"
character_seed = 80405
variants = [{
"id": "return",
"objective_done": ["sambo_plumes", "fetch_plumes"],
"objective_pending": ["sambo_plumes", "deliver_plumes"],
"actions": {"finish_quest": {"quest": "sambo_plumes", "objective": "deliver_plumes", "payout": 0}, "rep": {4: 3}},
"speaker": "Dona Lurdes (costumière)",
"text": "*ouvre la caisse, plonge les mains dans les plumes — vert, jaune, bleu — et soupire de soulagement* Te abençoe, sobrinho. La parade tient debout. *te tend une enveloppe craquante* T'as sauvé un défilé, ça vaut plus que ce qu'il y a dedans.",
"choices": ["Obrigado, dona"]
}, {
"id": "in_progress",
"quest_active": "sambo_plumes",
"speaker": "Dona Lurdes (costumière)",
"text": "*regarde sa montre toutes les vingt secondes* Le fournisseur s'appelle Tomé, il est en face du MAC à Niterói. Dis-lui que c'est Lurdes qui t'envoie.",
"choices": ["J'y vais"]
}, {
"id": "offer",
"quest_not_active": "sambo_plumes",
"quest_not_completed": "sambo_plumes",
"actions": {"accept_quest": "sambo_plumes"},
"speaker": "Dona Lurdes (costumière)",
"text": "*aiguille à la bouche, tissu plumes sur les épaules* Sobrinho ! La caisse de plumes de notre école a été livrée par erreur chez mon fournisseur de Niterói. Le défilé est dans une semaine. *te tape l'épaule* Tu prends la barca, tu vas chez Tomé en face du MAC, tu ramènes la caisse. 1700 reais et un place au premier rang en répétition.",
"choices": ["Je rapatrie les plumes"]
}, {
"id": "done",
"quest_completed": "sambo_plumes",
"speaker": "Dona Lurdes (costumière)",
"text": "*coud une queue de paon sur un dos d'écrevisse géante* L'école est prête, sobrinho. Cette année on rentre dans l'histoire.",
"choices": ["Bon défilé"]
}, {
"id": "default",
"speaker": "Dona Lurdes (costumière)",
"text": "*pique son aiguille dans son chignon* Le carnaval, c'est mille mains qui cousent pour une nuit. La mienne est la dernière.",
"choices": ["…"]
}]

[node name="ReinadoCargaSpot" parent="." instance=ExtResource("7_reactive")]
position = Vector2(315, 165)
npc_id = "reinado_carga"
prompt = "Le camarote de Tito"
character_seed = 90511
required_flag = "voie_trafico"
variants = [{
"id": "r2_close",
"objective_pending": ["reinado_a_carga", "entregar_carga"],
"actions": {"finish_quest": {"quest": "reinado_a_carga", "objective": "entregar_carga", "payout": 1200}},
"speaker": "Tito",
"text": "*le camarote domine l'avenue — nappes blanches, seaux à glace, et Tito en costume de lin qui t'accueille devant tout ce que Rio compte d'amis et d'ennemis* La carga, avant les portões. *il soulève un coin de bâche, hoche la tête, puis te prend par l'épaule et te tourne face à l'avenue* Regarde ça, parceiro. La Sapucaí. Y'a vingt ans je vendais de l'eau aux touristes, là, en bas. *il te met un verre dans la main* Ce soir tu livres en personne et tout le monde l'a vu : c'est ça, le message. Le desfile est à nous. Va voir Seu João — le bairro veut te voir le mener.",
"choices": ["Ao desfile"]
}, {
"id": "default",
"speaker": "Segurança",
"text": "*bras croisés devant l'escalier du camarote* Convidados, só. *il ne bouge pas d'un centimètre*",
"choices": ["…"]
}]

[node name="ReinadoCamaroteSpot" parent="." instance=ExtResource("7_reactive")]
position = Vector2(-300, 60)
npc_id = "reinado_camarote"
prompt = "Le poste de commandement"
character_seed = 90512
required_flag = "voie_policia"
variants = [{
"id": "r2_stakeout",
"objective_pending": ["reinado_b_camarote", "varrer_sapucai"],
"actions": {"start_stakeout": {"quest": "reinado_b_camarote", "objective": "varrer_sapucai", "duration": 24.0, "seed": "batedor_sapucai"}},
"speaker": "Opérateur radio",
"text": "*un préfabriqué coincé sous les gradins, des écrans, une radio qui crache* Capitão. *il te tend des jumelles sans se lever* Le binôme est dans la foule des répétitions — même école que celui du calçadão : il travaille les files, jamais il regarde l'avenue. Mille personnes, des tambours qui couvrent tout, et le Capitão a été clair : vous êtes SEUL. *il remet son casque* « C'est son règne, qu'il le prouve. » Ses mots, pas les miens. Boa sorte.",
