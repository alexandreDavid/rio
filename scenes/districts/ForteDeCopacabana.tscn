[node name="FilaColomboSpot" parent="." instance=ExtResource("8_reactive")]
position = Vector2(-70, -52)
npc_id = "fila_colombo"
prompt = "La fila du Colombo"
character_seed = 90541
variants = [{
"id": "domingo",
"speaker": "Dame de la fila",
"text": "*la file s'étire depuis la porte du Colombo, et personne ne s'impatiente — c'est Domingo* Quarante minutes d'attente, meu bem, et ça les vaut : le pão de queijo arrive encore chaud du four, et tu le manges face à TOUTE la plage. *elle avance d'un pas, solennelle* Ma mère faisait déjà cette fila. On ne vient pas pour le café. On vient pour la suite du monde.",
"choices": ["Bonne fila, dona"]
}, {
"id": "default",
"speaker": "Garçom du Colombo",
"text": "*il aligne les chaises de la terrasse, serviette sur l'épaule* La fila commence tôt le week-end, freguês. En semaine, tu as la baie pour toi tout seul — et le même café.",
"choices": ["…"]
}]

[node name="PescadorFig" type="ColorRect" parent="."]
