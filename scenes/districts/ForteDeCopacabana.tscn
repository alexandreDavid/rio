[node name="PescadorForteSpot" parent="." instance=ExtResource("8_reactive")]
position = Vector2(160, 186)
npc_id = "pescador_forte"
prompt = "Les rochers du Forte"
character_seed = 90542
variants = [{
"id": "tarde",
"phase": 2,
"speaker": "Pêcheur du Forte",
"text": "*trois cannes calées entre les rochers, la lumière dorée qui rase l'eau* C'est l'heure, garoto. La tainha passe au pied du Forte quand le soleil se couche — elle a jamais lu le règlement militaire. *il remonte une ligne vide, pas déçu du tout* Trente ans que je pêche ici. Le poisson, c'est le prétexte.",
"choices": ["Boa pesca"]
}, {
"id": "default",
"speaker": "Pêcheur du Forte",
"text": "*assis sur les rochers sous les canons, il surveille trois cannes d'un œil* Le meilleur poste de pêche de Copa, garoto — protégé par l'armée depuis 1914. *il rit tout seul* Personne ose me piquer ma place.",
"choices": ["…"]
}]

[node name="VeteranoSpot" parent="." instance=ExtResource("8_reactive")]
position = Vector2(60, -44)
npc_id = "veterano_forte"
prompt = "Le vétéran des canons"
character_seed = 90543
variants = [{
"id": "default",
"speaker": "Militar da reserva",
"text": "*képi impeccable, il fait sa ronde des canons comme si le fort attendait une escadre* Ces tourelles, garoto — du Krupp de 1914, jamais un coup tiré en guerre. *il tapote l'acier, presque tendre* Un seul, en 22, sur l'hôtel d'en face, pendant la révolte des Dix-Huit. Copacabana bombardée par Copacabana. *il rajuste son képi* Cette ville se bat toujours contre elle-même. Et elle se pardonne toujours après.",
"choices": ["…"]
}]

