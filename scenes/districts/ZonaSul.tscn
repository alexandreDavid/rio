# ─── NPCs interactables ──────────────────────────────────────────────────────
[node name="BettingKiosk" parent="." instance=ExtResource("15_betkiosk")]
position = Vector2(-690, -210)
bet_amount = 20

[node name="BikeRental" parent="." instance=ExtResource("16_bikerental")]
position = Vector2(200, -145)

[node name="ViewpointJardimEntrance" parent="." instance=ExtResource("3_view")]
position = Vector2(350, -730)
viewpoint_id = "jardim_entrance"
prompt_first = "Lire le panneau d'entrée"
flavor_speaker = "Sobrinho"
flavor_text = "Le Jardim Botânico do Rio de Janeiro, ouvert au public depuis 1822. Cent quarante hectares, six mille espèces, dont des palmiers, orchidées, bromélias. *passe sous le portail* Au début ce n'était qu'une plantation de cannelle et d'épices pour Dom João VI — aujourd'hui c'est un musée vivant."
money_reward = 30

[node name="ViewpointJardimPalmAlley" parent="." instance=ExtResource("3_view")]
position = Vector2(350, -940)
viewpoint_id = "jardim_palm_alley"
prompt_first = "Contempler l'allée des palmiers"
flavor_speaker = "Sobrinho"
flavor_text = "L'allée des Palmiers Impériaux. Cent quarante royal palms, chacun trente mètres de haut, alignés en double colonne. *renverse la tête en arrière* Dom João VI a planté le premier en 1809. Ses graines ont été distribuées à toute la noblesse de l'époque — c'est pour ça qu'on en voit dans tous les jardins anciens de Rio."
money_reward = 50

[node name="ViewpointJardimFountain" parent="." instance=ExtResource("3_view")]
position = Vector2(350, -780)
viewpoint_id = "jardim_fountain"
prompt_first = "S'approcher de la fontaine"
flavor_speaker = "Sobrinho"
flavor_text = "La fontaine centrale, vasque de granit. *écoute le jet* L'eau vient du Morro do Corcovado, captée en haut, descendue ici par aqueduc colonial. Les poissons rouges la traversent comme s'ils savaient qu'ils sont chez eux depuis deux siècles."
money_reward = 40

[node name="LagoaPedaloSpot" parent="." instance=ExtResource("14_dialogspot")]
position = Vector2(0, -215)
npc_id = "lagoa_pedalo"
prompt = "Parler au loueur de pédalo"
speaker = "Loueur"
text = "*amarre un pédalo jaune au quai* Vingt reais l'heure. Tu pédales toi-même, gentil. Et reviens avant qu'il fasse nuit — la Lagoa change de visage quand le soleil tombe."

[node name="JardimNaturalistSpot" parent="." instance=ExtResource("14_dialogspot")]
position = Vector2(350, -740)
npc_id = "jardim_naturalist"
prompt = "Parler au naturaliste"
speaker = "Naturaliste"
text = "*ajuste son chapeau de paille, ouvre un carnet d'observations* L'allée des palmiers impériaux, plantée par Dom João VI lui-même. Cent quarante d'entre eux. Tu peux toucher l'écorce — c'est permis."

# Viewpoint Cristo reflection sur la Lagoa
[node name="ViewpointLagoaCristo" parent="." instance=ExtResource("3_view")]
position = Vector2(50, -250)
viewpoint_id = "lagoa_cristo_reflection"
prompt_first = "Admirer le reflet du Cristo"
flavor_speaker = "Sobrinho"
flavor_text = "La Lagoa Rodrigo de Freitas, eau douce enchâssée entre les collines. Par temps clair, le Corcovado se reflète parfait dans le lac — Cristo les bras ouverts, à l'endroit et à l'envers en même temps. Rio en double."
money_reward = 70

