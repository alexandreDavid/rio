[node name="BondinhoOperadorSpot" parent="." instance=ExtResource("19_reactive")]
position = Vector2(860, 60)
npc_id = "bondinho_operador"
prompt = "Parler à l'opérateur du bondinho"
character_seed = 80301
variants = [{
"id": "offer",
"quest_not_active": "feijoada_bondinho",
"quest_not_completed": "feijoada_bondinho",
"actions": {"accept_quest": "feijoada_bondinho"},
"speaker": "Opérateur (bondinho)",
"text": "*compte sa caisse, te jauge* Eh, sobrinho. J'ai trois paniers de feijoada à monter au mirante pour un dîner privé — le chef attend là-haut. Je peux pas quitter le guichet en pleine après-midi. Bondinho gratos pour toi, livraison au sommet, je te file 800 reais à ton retour.",
"choices": ["Je m'en occupe"]
}, {
"id": "in_progress",
"quest_active": "feijoada_bondinho",
"speaker": "Opérateur (bondinho)",
"text": "*hoche le menton* Le bondinho est là, monte, livre. Le chef t'attend à la plateforme.",
"choices": ["J'y vais"]
}, {
"id": "done",
"quest_completed": "feijoada_bondinho",
"speaker": "Opérateur (bondinho)",
"text": "*sourit large* Tu m'as sauvé la mise. Si y a d'autres courses, t'es mon homme.",
"choices": ["À la prochaine"]
}, {
"id": "default",
"speaker": "Opérateur (bondinho)",
"text": "*ouvre la porte de la cabine* Bondinho 8 reais, freguês. Le coucher de soleil au pão vaut le détour.",
"choices": ["Plus tard"]
}]

[node name="AterroVendorSpot" parent="." instance=ExtResource("19_reactive")]
position = Vector2(-280, -650)
npc_id = "aterro_vendedor"
prompt = "Parler au revendeur"
character_seed = 80402
variants = [{
"id": "finish",
"objective_pending": ["maracana_jersey", "find_jersey"],
"actions": {"finish_quest": {"quest": "maracana_jersey", "objective": "find_jersey", "payout": 0}},
"speaker": "Revendeur (Aterro)",
"text": "*déballe un carton bleu, regarde autour avant de l'ouvrir* Le maillot 71 ? Six mois que je le tiens, le vieux Wanderley peut pas se déplacer. Le voilà — Pelé, Tostão, Carlos Alberto, tout est dedans. Ramène-lui-le, gamin, et dis-lui que c'est le dernier service.",
"choices": ["Compris"]
}, {
"id": "after",
"quest_completed": "maracana_jersey",
"speaker": "Revendeur (Aterro)",
"text": "*range des cartons* Wanderley t'a payé ? Bom. Reviens si tu cherches du vintage carioca — j'en ai d'autres.",
"choices": ["À l'occasion"]
}, {
"id": "default",
"speaker": "Revendeur (Aterro)",
"text": "*compte des billets pliés en quatre* Cartons à vendre, freguês : disques, maillots, vieilles photos. Tu cherches quelque chose ?",
"choices": ["Pas aujourd'hui"]
}]

[node name="CanotsObservationSpot" parent="." instance=ExtResource("19_reactive")]
position = Vector2(940, -70)
npc_id = "velho_mureta"
prompt = "Le vieux de la mureta"
character_seed = 90209
variants = [{
"id": "observe",
"objective_pending": ["act2_pecheur_secret", "observe_canots"],
"actions": {"finish_quest": {"quest": "act2_pecheur_secret", "objective": "observe_canots", "payout": 0}},
"speaker": "O velho da mureta",
"text": "*assis sur le muret, une bière tiède à la main, il te tend de vieilles jumelles sans que tu demandes rien* Tu regardes le large, hein. Comme l'autre, le pêcheur de Copa. *tu attends. La nuit tombe sur la baie. Et là — trois silhouettes noires, tous feux éteints, qui filent du large vers la pointe de Leme. Pas un bruit de moteur ne porte jusqu'ici.* *le vieux récupère ses jumelles* Ça fait trois semaines. Personne d'autre ne regarde. *il boit* La baie voit tout, menino. C'est les hommes qui choisissent de pas voir.",
"choices": ["Maintenant, je sais"]
}, {
"id": "default",
"speaker": "O velho da mureta",
"text": "*regarde la baie, sa bière posée sur le muret* La meilleure télé de Rio, menino. Et pas de pub.",
"choices": ["…"]
}]

[node name="TraficoChauffeurSpot" parent="." instance=ExtResource("19_reactive")]
position = Vector2(450, 60)
npc_id = "trafico_chauffeur"
prompt = "Le garage sous le Bondinho"
character_seed = 90207
variants = [{
"id": "a3_deliver",
"objective_pending": ["trafico_a3_chauffeur", "drive_botafogo"],
"actions": {"finish_quest": {"quest": "trafico_a3_chauffeur", "objective": "drive_botafogo", "payout": 0}, "rep": {2: 2}},
"speaker": "Garagiste de l'enseada",
"text": "*le rideau de fer se lève à moitié, juste assez pour la voiture. Un type en marcel essuie ses mains, jette un œil au coffre sans l'ouvrir* T'as pris l'avenue ou le tunnel ? *tu réponds pas. Il sourit* Bonne réponse. *il glisse le coffre sur un diable, disparaît dans le fond* Dis au morro que c'est passé. Et reprends un taxi — on laisse jamais la même voiture refaire le chemin.",
"choices": ["É nóis"]
}, {
"id": "default",
"speaker": "Garagiste de l'enseada",
"text": "*lève à peine les yeux de son moteur* Garage privé, irmão. Sauf si t'as rendez-vous — et t'as pas rendez-vous.",
"choices": ["…"]
}]

