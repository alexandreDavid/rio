[node name="CoalhoSpot" parent="." instance=ExtResource("19_reactive")]
position = Vector2(-252, -1076)
npc_id = "aterro_coalho"
prompt = "Le queijo coalho"
character_seed = 90552
variants = [{
"id": "default",
"speaker": "Vendeur de coalho",
"text": "*un petit gril au charbon, des brochettes de fromage qui dorent en grésillant* Queijo coalho na brasa, freguês ! Cinq reais, avec origan ou avec mélasse. *il tourne les brochettes d'un geste de chef d'orchestre* Trente ans que je fais l'Aterro — j'ai vu des gamins aux pipas devenir papas et revenir avec leurs gosses. Le fromage, lui, change pas. *il t'en tend une pointe à goûter, offerte*",
"choices": ["Com orégano, chefe"]
}]

