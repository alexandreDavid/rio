[node name="PoliciaPlanqueSpot" parent="." instance=ExtResource("19_reactive")]
position = Vector2(-260, 244)
npc_id = "policia_planque"
prompt = "Le garage aux volets verts"
character_seed = 80153
variants = [{
"id": "b3_close",
"flag": "policia_b3_marcha",
"objective_pending": ["policia_b3_escorte", "escort_patrol"],
"set_flag_after": "policia_b3_done",
"actions": {"finish_quest": {"quest": "policia_b3_escorte", "objective": "escort_patrol", "payout": 250}, "accept_quest": "policia_b4_descente", "debt_credit": 600, "rep": {1: 4}},
"speaker": "Sergent PM",
"text": "*les deux flics se glissent dans le garage aux volets verts, un par un, sans un regard pour toi. La radio grésille :* …On est en place, personne nous a calculés. Bien joué, gamin — t'as le pas du quartier, ça s'apprend pas. Le Capitão va aimer : il a déjà fait glisser un mot chez Nilton, ta dette a maigri. *une adresse tombe par l'entrebâillement* Ordre de Ramos : un dealer opère à Arpoador, Zona Sul. Arrestation. Propre si possible. Si ça part en vrille, t'auras rien vu. Maintenant dégage avant qu'on te voie traîner ici.",
"choices": ["Direction Arpoador"]
}, {
"id": "default",
"speaker": "Narrateur",
"text": "*Un garage aux volets verts délavés, rideau tiré. Rien ne bouge — ou alors c'est que quelqu'un s'applique.*",
"choices": ["…"]
}]

[node name="PlayerSpawnAterro" type="Marker2D" parent="."]
position = Vector2(-200, -660)

[node name="PrefeitoAterroSpot" parent="." instance=ExtResource("19_reactive")]
position = Vector2(-200, -649)
npc_id = "prefeito_aterro"
prompt = "Le tournoi de basket"
character_seed = 70402
variants = [{
"id": "d2_close",
"objective_pending": ["prefeito_d2_basquete", "run_tournament"],
"set_flag_after": "prefeito_d2_done",
"actions": {"finish_quest": {"quest": "prefeito_d2_basquete", "objective": "run_tournament", "payout": 200}, "accept_quest": "prefeito_d3_mediation", "debt_credit": 400, "rep": {0: 5}},
"speaker": "L'éducateur",
"text": "*siffle la fin d'un match sur le terrain de l'Aterro, gamins en sueur et rires* T'as monté ça en deux jours. Trente gosses qui auraient traîné dans la rue, là ils jouent. *te serre la main fort* Le Padre avait raison sur toi. La presse a même pris une photo — toi au centre, le bairro autour. Et les parents ont fait une vaquinha chez Nilton pour ton ardoise, sans que tu demandes rien. *essuie son front* Mais le Padre a un cas plus dur : une famille du morro en conflit ouvert avec un homme de Tito. Ça peut dégénérer. Il veut une médiation, pas du sang. Ta parole pèse, maintenant.",
"choices": ["Je remonte au morro"]
}, {
"id": "default",
"speaker": "Joueur de basket",
"text": "*dribble au bord du terrain de l'Aterro* Bora jogar, mano? A quadra tá livre. *enchaîne un panier*",
"choices": ["…"]
}]

