[node name="PoliciaEscorteSpot" parent="." instance=ExtResource("19_reactive")]
position = Vector2(44, 250)
npc_id = "policia_escorte"
prompt = "La patrouille en planque"
character_seed = 80114
variants = [{
"id": "b3_start",
"objective_pending": ["policia_b3_escorte", "escort_patrol"],
"not_flag": "policia_b3_marcha",
"set_flag_after": "policia_b3_marcha",
"speaker": "Sergent PM",
"text": "*deux flics en civil, adossés à une voiture qui refuse de démarrer sous le Bondinho* T'es le gars de Ramos ? *coup d'œil dégoûté au capot fumant* La banalisée vient de rendre l'âme, et la planque doit être montée avant la tombée du jour. *il claque la portière* Nouveau plan : on y va à pied, et c'est TOI qui ouvres. Deux flics qui marchent ensemble ici, tout le quartier le sait en cinq minutes — un gars du morro avec deux « cousins » en visite, personne calcule. *il rajuste sa chemise par-dessus son arme* Marche naturel, prends par l'ouest, et arrête-toi devant le garage aux volets verts. On te suit à dix pas.",
"choices": ["Suivez-moi — naturel"]
}, {
"id": "b3_march",
"objective_pending": ["policia_b3_escorte", "escort_patrol"],
"flag": "policia_b3_marcha",
"speaker": "Sergent PM",
"text": "*sans bouger les lèvres, à trois mètres derrière toi* Le garage aux volets verts, côté ouest. Traîne pas, et regarde pas en arrière — on n'existe pas.",
"choices": ["On avance"]
}, {
"id": "default",
"speaker": "Passant",
"text": "*photographie le Pão de Açúcar depuis l'Urca* Que vista, hein ? *poursuit sa marche*",
"choices": ["…"]
}]

