[node name="NiteroiPortoSpot" parent="." instance=ExtResource("16_reactive")]
position = Vector2(-200, 100)
npc_id = "niteroi_porto_contato"
prompt = "Parler à l'homme du quai"
character_seed = 80307
variants = [{
"id": "offer",
"quest_not_active": "niteroi_envelope",
"quest_not_completed": "niteroi_envelope",
"actions": {"accept_quest": "niteroi_envelope"},
"speaker": "Homme du port",
"text": "*costume kaki, mains nettoyées au calc., te jauge* Sobrinho. Une enveloppe scellée à remettre devant le MAC à un type — cravate bleue, mallette. 1100 reais, pas de questions. Tu es chaud ?",
"choices": ["Je le fais"]
}, {
"id": "in_progress",
"quest_active": "niteroi_envelope",
"speaker": "Homme du port",
"text": "*tape sa cigarette sur le quai* Le contact est devant le MAC, freguês. Cravate bleue, mallette.",
"choices": ["J'y vais"]
}, {
"id": "done",
"quest_completed": "niteroi_envelope",
"speaker": "Homme du port",
"text": "*recompte un rouleau de billets* L'enveloppe est passée. Ta réputation circule, sobrinho — bien ou mal, à toi de voir.",
"choices": ["À la prochaine"]
}, {
"id": "default",
"speaker": "Homme du port",
"text": "*scrute la baie* Les barcas partent toutes les heures. Niterói te fait peur, freguês ?",
"choices": ["Plus tard"]
}]

[node name="NiteroiMACContactSpot" parent="." instance=ExtResource("16_reactive")]
position = Vector2(700, 100)
npc_id = "niteroi_mac_contato"
prompt = "Parler au contact (cravate bleue)"
character_seed = 80308
variants = [{
"id": "finish",
"quest_active": "niteroi_envelope",
"actions": {"finish_quest": {"quest": "niteroi_envelope", "objective": "deliver_envelope", "payout": 0}},
"speaker": "Contact (cravate bleue)",
"text": "*mallette posée à ses pieds, regarde sa montre* Tu as quelque chose pour moi ? *prend l'enveloppe, la glisse dans la mallette, hoche la tête* Discret. C'est apprécié.",
"choices": ["De rien"]
}, {
"id": "after",
"quest_completed": "niteroi_envelope",
"speaker": "Contact (cravate bleue)",
"text": "*lit un journal devant le MAC* Tu repasses ? Le Niemeyer est fermé pour rénovation cette semaine.",
"choices": ["Bonne lecture"]
}, {
"id": "default",
"speaker": "Contact (cravate bleue)",
"text": "*regarde sa montre, soupire* J'attends quelqu'un. Pas toi.",
"choices": ["Désolé"]
}]

[node name="NiteroiPlumeFournisseurSpot" parent="." instance=ExtResource("16_reactive")]
position = Vector2(-500, 100)
npc_id = "niteroi_plumes_fornecedor"
prompt = "Parler à Tomé (fournisseur)"
character_seed = 80406
variants = [{
"id": "finish",
"objective_pending": ["sambo_plumes", "fetch_plumes"],
"actions": {"finish_quest": {"quest": "sambo_plumes", "objective": "fetch_plumes", "payout": 0}},
"speaker": "Tomé (fournisseur)",
"text": "*sort une caisse en bois plus haute que toi, regarde son ardoise* La caisse de Lurdes — vert, jaune, bleu, et la queue de paon. Désolé pour l'erreur de livraison, j'ai pris la barca de Niterói au lieu de Sapucaí. Embarque, freguês, et dis-lui que la prochaine est offerte.",
"choices": ["Je transmets"]
}, {
"id": "after",
"quest_completed": "sambo_plumes",
"speaker": "Tomé (fournisseur)",
"text": "*emballe d'autres plumes pour d'autres écoles* Lurdes a son défilé ?",
"choices": ["Elle est aux anges"]
}, {
"id": "default",
"speaker": "Tomé (fournisseur)",
"text": "*plumes vert-jaune-bleu partout dans la boutique* Le carnaval me nourrit toute l'année. Tu veux un échantillon ?",
"choices": ["Plus tard"]
}]

