[node name="ViewpointMAC" parent="." instance=ExtResource("3_view")]
position = Vector2(0, 50)
viewpoint_id = "niteroi_mac"
prompt_first = "Admirer le MAC Niemeyer"
flavor_speaker = "Sobrinho"
flavor_text = "Le MAC, le Musée d'Art Contemporain, signé Oscar Niemeyer en 1996. *renverse la tête en arrière* Une soucoupe blanche sur un pédestal, posée comme un objet trouvé sur la baie. Niemeyer disait que la beauté en architecture, c'est la simplicité de la courbe. *long silence* De l'autre côté, Rio se découpe — le Pão de Açúcar à gauche, le Corcovado à droite. Tu vois ta ville comme une carte postale."
money_reward = 80

[node name="ViewpointBay" parent="." instance=ExtResource("3_view")]
position = Vector2(-400, -25)
viewpoint_id = "niteroi_baia_view"
prompt_first = "Regarder la baie de Guanabara"
flavor_speaker = "Sobrinho"
flavor_text = "La baie de Guanabara. Quatre cents kilomètres carrés d'eau salée prise entre Rio et Niterói. Les ferries traversent toutes les vingt minutes. *le vent vient du sud-est, frais* Quand tu vis à Rio, tu oublies que la ville est entourée d'eau. Ici tu t'en souviens."
money_reward = 50

