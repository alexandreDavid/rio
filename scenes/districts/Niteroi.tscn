[node name="IcaraiSerestaSpot" parent="." instance=ExtResource("16_reactive")]
position = Vector2(1655, 190)
npc_id = "icarai_seresta"
prompt = "Le coreto d'Icaraí"
character_seed = 90532
variants = [{
"id": "seresta",
"phase": 2,
"speaker": "Sobrinho",
"text": "*au coreto d'Icaraí, un violão et deux voix qui se cherchent — une seresta comme on n'en fait plus. Un couple d'anciens danse tout doucement, front contre front, et Rio scintille de l'autre côté de la baie. Personne ne filme. C'est peut-être pour ça que c'est beau.*",
"choices": ["*écouter un moment*"]
}, {
"id": "default",
"speaker": "Sobrinho",
"text": "*le coreto d'Icaraí, vide sous le soleil — un kiosque à musique comme au temps des serestas. Le soir, dit-on, les anciens y dansent encore.*",
"choices": ["…"]
}]
