"actions": {"finish_quest": {"quest": "consortium_c5_mac", "objective": "launder_mac", "payout": 800}, "accept_quest": "consortium_c6_tioze", "pay_debt": 5000, "rep": {4: 6}},
"speaker": "L'attachée du MAC",
"text": "*tailleur impeccable, sous la soucoupe de Niemeyer* Sr. Magalhães, quel mécène généreux. *prend la mallette, te tend un reçu de donation officiel encadré* Une plaque à votre nom près de l'entrée, si vous voulez. *sourire parfait* L'argent entre en chiffres sales et ressort en vertu gravée dans le bronze. *baisse la voix, te raccompagne* Un message — pas de la maison, celui-là. Un vieux concierge du Copacabana Palace a demandé après vous. Au sujet de votre oncle, et de ce que le Consórcio est vraiment. Moi je transmets l'art, pas les conseils.",
"choices": ["Je rentre voir le concierge"]
}, {
"id": "default",
"speaker": "Visiteur du MAC",
"text": "*photographie la soucoupe de Niemeyer* Que arquitetura, hein? Parece um disco voador. *recule pour le cadrage*",
"choices": ["…"]
}]

[node name="PrefeitoNiteroiSpot" parent="." instance=ExtResource("16_reactive")]
position = Vector2(480, 130)
