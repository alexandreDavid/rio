[node name="TraficoNiteroiSpot" parent="." instance=ExtResource("16_reactive")]
position = Vector2(400, 130)
npc_id = "trafico_niteroi"
prompt = "Le relais (Mafia da Baía)"
character_seed = 80116
variants = [{
"id": "a8_close",
"objective_pending": ["trafico_a8_baia", "cross_baia"],
"set_flag_after": "trafico_a8_done",
"actions": {"finish_quest": {"quest": "trafico_a8_baia", "objective": "cross_baia", "payout": 1500}, "accept_quest": "trafico_a9_corrida", "pay_debt": 18000, "rep": {2: 8, 0: -4}},
"speaker": "Don Vincenzo",
"text": "*costume sombre, accent italo-carioca, t'inspecte des pieds à la tête* Donc c'est toi, le nouveau du morro de Tito. *fait signe ; ses hommes déchargent la cargaison de la barque, vite, sans un mot* Bella mercadoria. Dis à Tito que la baie est ouverte tant qu'il tient sa parole. *te tend une mallette épaisse* Presque toute ta dette d'un coup, ragazzo. *allume un cigare* Il reste une chose : Tito monte la dernière corrida du Carnaval — celle qui scelle un règne. Il t'attend, en personne, au morro. Si tu la mènes, le Morro est à toi.",
"choices": ["Je retourne au morro"]
}, {
"id": "default",
"speaker": "Passant de Niterói",
"text": "*regarde Rio de l'autre côté de la baie* Daqui a vista é melhor, sabia? On voit tout le Pão de Açúcar. *poursuit son chemin*",
"choices": ["…"]
}]

[node name="PoliciaSaisieSpot" parent="." instance=ExtResource("16_reactive")]
position = Vector2(440, 100)
npc_id = "policia_saisie"
prompt = "La saisie (cargaison)"
character_seed = 80117
variants = [{
"id": "b7_close",
"objective_pending": ["policia_b7_saisie", "seize_cargo"],
"set_flag_after": "policia_b7_done",
"actions": {"finish_quest": {"quest": "policia_b7_saisie", "objective": "seize_cargo", "payout": 600}, "accept_quest": "policia_b8_seguranca", "pay_debt": 4000, "rep": {1: 5}},
"speaker": "Don Vincenzo",
"text": "*encadré par ses hommes, le mandat de Ramos à la main que tu lui colles sous le nez* …Donc Ramos envoie un gamin du morro faire son sale boulot. *crache, fait signe à ses hommes de ne pas bouger* Prends ta cargaison, ragazzo. Mais retiens ça : aujourd'hui tu saisis pour Ramos, et Ramos travaille pour les mêmes que moi. Tu sers personne. *sourire froid, ta radio crache l'ordre suivant :* « Saisie homologuée. Dernier gros morceau : un rassemblement gêne au Maracanã. Ramos veut que tu sécurises la foule. C'est ça qui éponge ta dette. »",
"choices": ["Direction le Maracanã"]
}, {
"id": "default",
"speaker": "Passant de Niterói",
"text": "*regarde Rio par-dessus la baie* A barca demora hoje, viu? *hausse les épaules*",
"choices": ["…"]
}]

