[node name="ConsortiumNiteroiSpot" parent="." instance=ExtResource("16_reactive")]
position = Vector2(360, 130)
npc_id = "consortium_niteroi"
prompt = "Le MAC (donation)"
character_seed = 80118
variants = [{
"id": "c5_nego",
"objective_pending": ["consortium_c5_mac", "launder_mac"],
"speaker": "L'attachée du MAC",
"text": "*tailleur impeccable, sous la soucoupe de Niemeyer — elle ne touche pas la mallette* Une « donation » de Sr. Magalhães. *elle laisse le mot flotter, désagréable* Le conseil se réunit dans une heure et la moitié voudra refuser. Comprenez-moi : je ne sers pas les mécènes, monsieur. Je sers cette institution — trente ans que je la défends contre les gens qui la prennent pour un tremplin ou pour une lessiveuse. *elle regarde la baie, pas vous* Donnez-moi une raison que je puisse prononcer devant le conseil sans baisser les yeux. *L'avocat de Magalhães, derrière toi, murmure : « Chaque passage devant le conseil, la maison te facture 250 R$ de dossier. Lis-la bien. »*",
"choices": ["Épaissir l'enveloppe : un zéro de plus, discrètement", "Menacer : le consortium peut revoir le bail du musée", "Proposer une salle au nom d'un artiste du morro — l'institution d'abord, le donateur en silence"],
"choice_actions": {"0": {"pay_bribe": 250, "rep": {4: -2}}, "1": {"pay_bribe": 250, "rep": {4: -2}}, "2": {"finish_quest": {"quest": "consortium_c5_mac", "objective": "launder_mac", "payout": 800}, "set_flag": "consortium_c5_done", "rep": {4: 6}}}
}, {
"id": "c5_close",
"quest_completed": "consortium_c5_mac",
"quest_not_active": "consortium_c6_tioze",
"quest_not_completed": "consortium_c6_tioze",
"actions": {"accept_quest": "consortium_c6_tioze", "pay_debt": 5000},
"speaker": "L'attachée du MAC",
"text": "*elle a plaidé votre salle devant le conseil sans une hésitation — la donation est passée à l'unanimité. Elle vous tend un reçu officiel encadré* « Sala Heitor do Morro ». Vous m'avez donné une raison prononçable, je l'ai prononcée. *sourire parfait, presque triste* L'argent entre en chiffres sales et ressort en vertu gravée dans le bronze — et la maison a soldé une belle part de votre ardoise pour fêter ça. *baisse la voix, vous raccompagne* Un message — pas de la maison, celui-là. Un vieux concierge du Copacabana Palace a demandé après vous. Au sujet de votre oncle, et de ce que le Consórcio est vraiment. Moi je transmets l'art, pas les conseils.",
