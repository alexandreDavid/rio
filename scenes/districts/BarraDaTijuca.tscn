prompt_first = "Admirer l'horizon Barra"
flavor_speaker = "Sobrinho"
flavor_text = "Dix-huit kilomètres de plage rectiligne, sans rocher, sans bout. Le vent vient d'Angra. Les surfeurs disent que l'eau est plus froide ici — courant ascendant. La Barra c'est l'Atlantique en mode plein, sans découpe."
money_reward = 60

